# Copy this to .env (never commit your real .env)
FORGEJO_URL=http://127.0.0.1:3020
FORGEJO_TOKEN=PASTE_A_SCOPED_FORGEJO_PERSONAL_ACCESS_TOKEN_HERE
MYGIT_MCP_PORT=3030
MYGIT_TRANSPORT=http
# Safe by default, absolutely no write tools exposed.
MYGIT_WRITE_ENABLED=false
# Needed when enabling writes: comma-separated owner/repository names
MYGIT_ALLOWED_REPOS=
# Whitelisted workflow name - never arbitrary names from AI
MYGIT_APK_WORKFLOW=build-apk.yml
