+}
+
+class _OperatorLoginState extends State<_OperatorLogin> with Tasks<_OperatorLogin> {
+  late List<StoreOperator> _operators = widget.operators;
+
+  Future<void> _refresh() => task(() async {
+    final host = widget.session.forWorkplace(widget.store.location());
+    try {
+      _operators = await host.api.storeOperators() ??
+          (throw ApiFailure(503, 'operator_login_unavailable'));
+    } finally {
+      host.api.retireWorkplace();
+    }
+  });
+
+  Future<void> _select(StoreOperator operator) async {
+    if (busy) return;
+    String? code;
+    if (!operator.isOwner) {
+      code = await inputValue(
+        context, operator.name, _tr(context, 'Код сотрудника', 'Xodim kodi'),
+        secret: true, maxLength: 128, trim: false,
+      );
+      if (!mounted || code == null) return;
+    }
+    await task(() async {
+      if (code != null && (code!.length < 8 || code!.length > 128)) {
+        throw FormatException(_tr(context, 'Введите код из 8–128 символов.',
+          '8–128 belgidan iborat kodni kiriting.'));
+      }
+      if (operator.isOwner) {
+        try {
+          await widget.session.login.reauthenticateOwner();
+        } on DeviceLoginCancelled {
+          return;
+        }
+      }
+      if (!mounted) return;
+      final host = widget.session.forWorkplace(widget.store.location());
+      try {
+        final terminal = operator.roles.contains(Desk.cashier)
+            ? await host.api.operatorTerminal() : null;
+        if (!operator.isOwner && terminal == null &&
+            operator.roles.length == 1 && operator.roles.contains(Desk.cashier)) {
+          throw ApiFailure(403, 'operator_terminal_required');
+        }
+        final opened = await host.api.signInOperator(operator, code);
+        code = null;
+        final register = opened.operator.roles.contains(Desk.cashier) ? terminal : null;
+        final workplace = widget.session.forWorkplace(
+          KassaLocation(widget.store.id, register?.id,
+            utcOffsetMinutes: widget.store.utcOffsetMinutes),
+          operator: opened,
+        );
+        var selected = false;
+        try {
+          final available = opened.operator.roles;
+          if (register == null && available.length == 1 &&
+              available.contains(Desk.cashier)) {
+            throw ApiFailure(403, 'operator_terminal_required');
+          }
+          try {
+            await host.api.rememberOperatorStore();
+          } on Exception {
+            // A remembered store is just a shortcut for the next login.
+          }
+          if (!mounted) return;
+          Navigator.pop<_SelectedWorkplace>(context, (
+            pos: workplace, store: widget.store, register: register, roles: available,
+          ));
+          selected = true;
+        } finally {
+          if (!selected) {
+            workplace.api.retireWorkplace();
+            await workplace.api.closeOperatorSession(opened.operator.roles.first);
+          }
+        }
+      } finally {
+        host.api.retireWorkplace();
+      }
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) => PopScope(
+    canPop: !busy,
+    child: _WorkplacePage(
+      title: Text(widget.store.name, overflow: TextOverflow.ellipsis),
+      actions: [
+        IconButton(
+          onPressed: busy ? null : _refresh,
+          tooltip: _tr(context, 'Обновить сотрудников', 'Xodimlarni yangilash'),
+          icon: const Icon(Icons.refresh),
+        ),
+      ],
+      children: [
+        const _WorkspaceTitle(_UiText('Кто работает?', 'Kim ishlaydi?')),
+        if (busy) const LinearProgressIndicator(),
+        if (status case final message?) StatusBox(message, error: failed),
+        if (_operators.isEmpty)
+          const _UiStatus('В магазине пока нет сотрудников.', 'Do‘konda hozircha xodimlar yo‘q.'),
+        for (final operator in _operators)
+          _WorkplaceRow(
+            child: ListTile(
+              leading: Icon(operator.isOwner ? Icons.admin_panel_settings_outlined : Icons.person_outline),
+              title: Text(operator.name),
+              subtitle: operator.isOwner
+                  ? const _UiText('Владелец', 'Egasi')
+                  : Text(operator.roles.map((role) => role.nameFor(context)).join(' · ')),
+              trailing: const Icon(Icons.chevron_right),
+              onTap: busy ? null : () => _select(operator),
+            ),
+          ),
+      ],
+    ),
+  );
+}
