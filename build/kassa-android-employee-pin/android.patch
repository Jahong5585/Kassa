+part of 'pos.dart';
+
+class StoreOperator {
+  const StoreOperator(this.id, this.name, this.roles, {required this.isOwner});
+
+  final String id;
+  final String name;
+  final Set<Desk> roles;
+  final bool isOwner;
+
+  static StoreOperator _fromJson(dynamic data) {
+    if (data is! Json ||
+        !_assignedId(data['operatorId']) ||
+        data['displayName'] is! String ||
+        (data['displayName'] as String).trim().isEmpty ||
+        data['isOwner'] is! bool ||
+        data['passwordRequired'] != (data['isOwner'] == false) ||
+        data['active'] != true) {
+      throw ApiFailure(0, 'invalid_server_response');
+    }
+    return StoreOperator(
+      data['operatorId'] as String,
+      data['displayName'] as String,
+      _operatorRoles(data['roles']),
+      isOwner: data['isOwner'] as bool,
+    );
+  }
+}
+
+class OperatorSession {
+  const OperatorSession._(this.operator, this.token);
+
+  final StoreOperator operator;
+  final String token;
+}
+
+Set<Desk> _operatorRoles(dynamic values) {
+  if (values is! List ||
+      values.isEmpty ||
+      values.any((role) => !Desk.values.any((desk) => desk.code == role)) ||
+      values.toSet().length != values.length) {
+    throw ApiFailure(0, 'invalid_server_response');
+  }
+  return Set.unmodifiable(Desk.values.where((desk) => values.contains(desk.code)));
+}
+
+extension OperatorAccess on ServerApi {
+  Future<List<StoreOperator>?> storeOperators() async {
+    final dynamic data;
+    try {
+      data = await request('GET', '$store/operators');
+    } on ApiFailure catch (failure) {
+      if (failure._routeUnavailable) return null;
+      rethrow;
+    }
+    if (data is! Json || data['storeId'] != storeId || data['items'] is! List) {
+      throw ApiFailure(0, 'invalid_server_response');
+    }
+    final seen = <String>{};
+    return [
+      for (final row in (data['items'] as List))
+        if (row is! Json || row['active'] != false)
+          _checkedOperator(row, seen),
+    ];
+  }
+
+  StoreOperator _checkedOperator(dynamic row, Set<String> seen) {
+    final operator = StoreOperator._fromJson(row);
+    if (!seen.add(operator.id)) throw ApiFailure(0, 'invalid_server_response');
+    return operator;
+  }
+
+  Future<OperatorSession> signInOperator(StoreOperator selection, String? code) async {
+    final deviceKey = 'kassa.operator.device.v1.${origin.origin}';
+    final savedId = await login._storage.read(key: deviceKey);
+    final deviceId = _assignedId(savedId) ? savedId! : newId();
+    if (savedId != deviceId) {
+      await login._storage.write(key: deviceKey, value: deviceId);
+    }
+    final data = await request(
+      'POST', '$store/operator-sessions',
+      body: {
+        'operatorId': selection.id,
+        'password': code,
+        'deviceId': deviceId,
+      },
+    );
+    if (data is! Json || data['storeId'] != storeId ||
+        !_assignedId(data['sessionId']) || !_assignedId(data['organizationId']) ||
+        data['operatorSessionToken'] is! String ||
+        !RegExp(r'^[a-zA-Z0-9_-]{32,200}$').hasMatch(data['operatorSessionToken'] as String)) {
+      throw ApiFailure(0, 'invalid_server_response');
+    }
+    final operator = StoreOperator._fromJson(data['operator']);
+    if (operator.id != selection.id || operator.isOwner != selection.isOwner) {
+      throw ApiFailure(0, 'invalid_server_response');
+    }
+    return OperatorSession._(operator, data['operatorSessionToken'] as String);
+  }
+
+  Future<void> closeOperatorSession(Desk role) async {
+    final opened = operatorSession;
+    if (opened == null) return;
+    final closing = ServerApi._forWorkplace(this, location, operatorSession: opened);
+    try {
+      await closing.request('DELETE', '/v1/operator-sessions/current',
+          desk: opened.operator.roles.contains(role) ? role : opened.operator.roles.first);
+    } on ApiFailure catch (failure) {
+      if (failure.status != 401 && failure.status != 403) rethrow;
+    } finally {
+      closing.retireWorkplace();
+    }
+  }
+
+  String _registerStorageKey(String id) {
+    _ensureWorkplace();
+    return KassaLocation(storeId, id, platformOrganizationId: location.platformOrganizationId)
+        .storageKey(origin.origin, login.subject, Desk.cashier, 'register-key');
+  }
+
+  Future<String?> savedRegisterKey(String id) =>
+      login._storage.read(key: _registerStorageKey(id));
+
+  String get _terminalKey => KassaLocation(storeId, null)
+      .storageKey(origin.origin, login.subject, Desk.admin, 'operator-terminal');
+
+  Future<AssignedRegister?> operatorTerminal() async {
+    final value = await login._storage.read(key: _terminalKey);
+    if (value == null) return null;
+    final dynamic data;
+    try {
+      data = jsonDecode(value);
+    } on FormatException {
+      return null;
+    }
+    if (data is! Json || !_assignedId(data['id']) || data['name'] is! String) return null;
+    final id = data['id'] as String;
+    final credential = await savedRegisterKey(id);
+    return credential != null && RegExp(r'^[a-fA-F0-9]{64}$').hasMatch(credential)
+        ? AssignedRegister(id, data['name'] as String)
+        : null;
+  }
+
+  Future<void> setOperatorTerminal(StoreRegister register, {String? issuedKey}) async {
+    if (!storeOwner || operatorSession?.operator.isOwner != true || !register.active) {
+      throw ApiFailure(403, 'owner_access_required');
+    }
+    if (issuedKey != null) {
+      Login._validateRegisterKey(issuedKey);
+      await login._storage.write(key: _registerStorageKey(register.id), value: issuedKey);
+    }
+    if (await savedRegisterKey(register.id) == null) {
+      throw ApiFailure(403, 'register_key_required');
+    }
+    _ensureWorkplace();
+    await login._storage.write(key: _terminalKey,
+        value: jsonEncode({'id': register.id, 'name': register.name}));
+  }
+
+  String get _lastOperatorStoreKey =>
+      'kassa.operator.last-store.v1.${origin.origin}.${login.subject}';
+
+  Future<String?> lastOperatorStore() => login._storage.read(key: _lastOperatorStoreKey);
+
+  Future<void> rememberOperatorStore() =>
+      login._storage.write(key: _lastOperatorStoreKey, value: storeId);
+}
+
+typedef LocalEmployee = ({String id, String name, Set<Desk> roles, bool active, int version});
+
+class OperatorManagementApi {
+  OperatorManagementApi(this.pos);
+  final Pos pos;
+  ServerApi get _api => pos.api;
+  String get _path => '${_api.store}/employees';
+
+  static LocalEmployee _employee(dynamic row) {
+    if (row is! Json || !_assignedId(row['employeeId']) ||
+        row['displayName'] is! String || row['active'] is! bool ||
+        row['version'] is! int || (row['version'] as int) < 1) {
+      throw ApiFailure(0, 'invalid_server_response');
+    }
+    return (id: row['employeeId'] as String, name: row['displayName'] as String,
+      active: row['active'] as bool, version: row['version'] as int,
+      roles: _operatorRoles(row['roles']));
+  }
+
+  Future<List<LocalEmployee>> employees() async {
+    final result = <LocalEmployee>[];
+    int? offset = 0;
+    while (offset != null) {
+      final data = await _api.request('GET', _path, desk: Desk.admin,
+          query: {'offset': '$offset', 'limit': '50'});
+      if (data is! Json || data['items'] is! List ||
+          (data['nextOffset'] != null &&
+           (data['nextOffset'] is! int || (data['nextOffset'] as int) <= offset))) {
+        throw ApiFailure(0, 'invalid_server_response');
+      }
+      result.addAll((data['items'] as List).map(_employee));
+      offset = data['nextOffset'] as int?;
+    }
+    return result;
+  }
+
+  Future<LocalEmployee> createEmployee(String id, String first, String last,
+      Set<Desk> roles, String code) async {
+    final row = _employee(await _api.request('POST', _path, desk: Desk.admin,
+      extraHeaders: {'Idempotency-Key': id},
+      body: {
+        'employeeId': id,
+        'firstName': first,
+        'lastName': last,
+        'roles': roles.map((desk) => desk.code).toList(),
+        'password': code,
+        'reason': 'Создание сотрудника в Android',
+      },
+    ));
+    if (row.id != id || !row.active || !setEquals(row.roles, roles)) {
+      throw ApiFailure(0, 'invalid_server_response');
+    }
+    return row;
+  }
+
+  Future<LocalEmployee> editRoles(LocalEmployee row, Set<Desk> roles) async {
+    final updated = _employee(await _api.request('PUT', '$_path/${row.id}/roles',
+      desk: Desk.admin,
+      body: {
+        'expectedVersion': row.version,
+        'roles': roles.map((desk) => desk.code).toList(),
+        'reason': 'Назначение ролей в Android',
+      },
+    ));
+    if (updated.id != row.id || updated.version != row.version + 1 ||
+        !setEquals(updated.roles, roles)) {
+      throw ApiFailure(0, 'invalid_server_response');
+    }
+    return updated;
+  }
+
+  Future<LocalEmployee> resetCode(LocalEmployee row, String code) async {
+    final updated = _employee(await _api.request('POST', '$_path/${row.id}/reset-password',
+      desk: Desk.admin,
+      body: {
+        'expectedVersion': row.version,
+        'newPassword': code,
+        'reason': 'Смена кода сотрудника в Android',
+      },
+    ));
+    if (updated.id != row.id || updated.version != row.version + 1) {
+      throw ApiFailure(0, 'invalid_server_response');
+    }
+    return updated;
+  }
+
+  Future<StoreRegister> assignCashiers(StoreRegister register, Set<String> ids) async {
