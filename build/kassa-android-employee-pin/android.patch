+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:kassa_mobile/main.dart';
+import 'package:kassa_mobile/pos.dart';
+
+const _store = '30000000-0000-4000-8000-000000000031';
+const _register = '30000000-0000-4000-8000-000000000032';
+const _owner = '30000000-0000-4000-8000-000000000033';
+const _worker = '30000000-0000-4000-8000-000000000034';
+const _sessionId = '30000000-0000-4000-8000-000000000035';
+const _organization = '30000000-0000-4000-8000-000000000036';
+const _base = '/v1/stores/$_store';
+final _registerKey = 'b' * 64;
+final _ownerToken = 'o' * 43;
+final _workerToken = 'w' * 43;
+
+class _OperatorHost extends Login {
+  _OperatorHost(super.storage);
+
+  int confirmations = 0;
+
+  @override
+  String get subject => 'account-owner';
+
+  @override
+  Future<bool> restore() async => true;
+
+  @override
+  Future<void> reauthenticateOwner() async { confirmations++; }
+
+  @override
+  Future<String> accessToken({bool force = false}) async {
+    expect(force, false, reason: 'An incorrect employee code must not refresh the owner login');
+    return 'oidc-host-token';
+  }
+}
+
+http.Response _reply(Object? value, [int status = 200]) =>
+    http.Response.bytes(utf8.encode(jsonEncode(value)), status,
+        headers: {'content-type': 'application/json; charset=utf-8'});
+
+void main() {
+  testWidgets('a saved phone opens the employee list and uses their roles and terminal key',
+      (tester) async {
+    final host = _OperatorHost(const FlutterSecureStorage());
+    final operators = [
+      {'operatorId': _worker, 'displayName': 'Камола',
+        'roles': ['cashier', 'receiver'], 'isOwner': false,
+        'passwordRequired': true, 'active': true},
+      {'operatorId': _owner, 'displayName': 'Владелец магазина',
+        'roles': ['admin', 'cashier', 'receiver'], 'isOwner': true,
+        'passwordRequired': false, 'active': true},
+      {'operatorId': _organization, 'displayName': 'Отключённый сотрудник', 'active': false},
+    ];
+    String? deviceId;
+    Json? shift;
+    var logouts = 0;
+    var opened = false;
+    var expired = false;
+    final pos = Pos(
+      const FlutterSecureStorage(),
+      login: host,
+      productionContract: true,
+      client: MockClient((request) async {
+        expect(request.headers['Authorization'], 'Bearer oidc-host-token');
+        final token = request.headers['X-Operator-Session'];
+        switch (request.url.path) {
+          case '/v1/me/stores':
+            expect(token, isNull);
+            return _reply({
+              'items': [{
+                'storeId': _store, 'storeName': 'Korzinka',
+                'organizationId': _organization, 'timeZone': 'Asia/Tashkent',
+                'utcOffsetMinutes': 300, 'isOwner': true, 'active': true,
+              }],
+              'nextOffset': null,
+            });
+          case '$_base/operators':
+            expect(token, isNull);
+            return _reply({'storeId': _store, 'items': operators});
+          case '$_base/operator-sessions':
+            expect(token, isNull);
+            final body = jsonDecode(request.body) as Json;
+            deviceId ??= body['deviceId'] as String;
+            expect(body['deviceId'], deviceId);
+            final owner = body['operatorId'] == _owner;
+            if (owner) {
+              expect(host.confirmations, 1);
+              expect(body['password'], isNull);
+            } else if (body['password'] != '02468135') {
+              return _reply({'code': 'operator_credentials_invalid'}, 401);
+            }
+            return _reply({'storeId': _store, 'organizationId': _organization,
+              'sessionId': _sessionId, 'operatorSessionToken': owner ? _ownerToken : _workerToken,
+              'operator': operators[owner ? 1 : 0]});
+          case '/v1/shifts/active':
+          case '/v1/shifts':
+            expect(token, anyOf(_workerToken, _ownerToken));
+            expect(request.headers['X-Active-Role'], 'cashier');
+            expect(request.headers['X-Register-Id'], _register);
+            expect(request.headers['X-Register-Key'], _registerKey);
+            if (request.method == 'POST') {
+              final body = jsonDecode(request.body) as Json;
+              expect(token, _workerToken);
+              shift = {'shiftId': body['shiftId'], 'openingCash': body['openingCash']};
+              opened = true;
+              return _reply(shift);
+            }
+            return _reply({'shift': shift});
+          case '/v1/me/roles':
+            expect(token, _workerToken);
+            if (expired) return _reply({'code': 'operator_session_expired'}, 401);
+            return _reply({'storeId': _store, 'staffId': _worker,
+              'roles': ['cashier', 'receiver'], 'owner': false});
+          case '$_base/receiving/catalog/proposals':
+            expect(token, _ownerToken);
+            expect(request.headers['X-Active-Role'], 'admin');
+            return _reply([]);
+          case '/v1/operator-sessions/current':
+            expect(token, _ownerToken);
+            expect(request.method, 'DELETE');
+            logouts++;
+            return http.Response('', 204);
+          default:
+            fail('Unhandled test request: ${request.method} ${request.url.path}');
+        }
+      }),
+    );
+    final origin = pos.api.origin.origin;
+    FlutterSecureStorage.setMockInitialValues({
+      KassaLocation(_store, _register).storageKey(origin, host.subject, Desk.cashier, 'register-key'):
+        _registerKey,
+      KassaLocation(_store, null).storageKey(origin, host.subject, Desk.admin, 'operator-terminal'):
+        jsonEncode({'id': _register, 'name': 'Касса телефона'}),
+    });
+
+    Future<void> tap(Finder finder) async {
+      await tester.tap(finder);
+      await tester.pumpAndSettle();
+    }
+
+    Future<void> login(String code) async {
+      await tap(find.text('Камола'));
+      expect(find.text('Код сотрудника'), findsOneWidget);
+      await tester.enterText(find.byType(TextFormField), code);
+      await tap(find.text('Подтвердить'));
+    }
+
+    await tester.pumpWidget(KassaApp(pos: pos));
+    await tester.pumpAndSettle();
+    expect(find.text('Кто работает?'), findsOneWidget);
+    expect(find.text('Отключённый сотрудник'), findsNothing);
+    await tap(find.text('Владелец магазина'));
+    expect(find.widgetWithText(TextButton, 'Администратор'), findsOneWidget);
+    await tap(find.byTooltip('Сменить сотрудника'));
+    expect(logouts, 1);
+    await login('02468134');
+    expect(find.text('Проверьте код сотрудника.'), findsOneWidget);
+    await login('02468135');
+    expect(find.text('Касса телефона'), findsOneWidget);
+    expect(find.byType(NavigationBar), findsNothing);
+    expect(find.text('Подключить кассу'), findsNothing);
+    await tester.tap(find.text('Открыть смену'));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 350));
+    await tap(find.text('Подтвердить'));
+    expect(opened, true);
+    expect(find.text('Смена открыта'), findsOneWidget);
+    expect(find.text('Штрихкод'), findsOneWidget);
+    await tap(find.widgetWithText(TextButton, 'Кассир'));
+    expect(find.text('Администратор'), findsNothing);
+    await tap(find.text('Приёмщик'));
+    expect(find.widgetWithText(TextButton, 'Приёмщик'), findsOneWidget);
+    expired = true;
+    await tap(find.widgetWithText(TextButton, 'Приёмщик'));
+    expect(find.text('Кто работает?'), findsOneWidget);
+    expect(host.confirmations, 1);
+    final data = await pos.storage.readAll();
+    expect(data.values, isNot(contains(_workerToken)));
+    expect(data.values, isNot(contains('02468135')));
+    expect(tester.takeException(), isNull);
+  });
+
+  test('the owner creates a terminal and assigns employees without copying its key', () async {
+    FlutterSecureStorage.setMockInitialValues({});
+    const storage = FlutterSecureStorage();
+    String? issuedKey;
+    final owner = {
+      'operatorId': _owner, 'displayName': 'Владелец',
+      'roles': ['admin', 'cashier', 'receiver'], 'isOwner': true,
+      'passwordRequired': false, 'active': true,
+    };
+    final root = Pos(storage, login: _OperatorHost(storage), productionContract: true,
+      client: MockClient((request) async {
+        final body = jsonDecode(request.body) as Json;
+        if (request.url.path == '$_base/operator-sessions') {
+          return _reply({'storeId': _store, 'organizationId': _organization,
+            'sessionId': _sessionId, 'operatorSessionToken': _ownerToken, 'operator': owner});
+        }
+        expect(request.headers['X-Operator-Session'], _ownerToken);
+        expect(request.headers['X-Active-Role'], 'admin');
+        expect(request.headers['X-Register-Key'], isNull);
+        if (request.url.path == '$_base/employees') {
+          expect(request.headers['Idempotency-Key'], _worker);
+          expect(body['password'], '02468135');
+          expect(body['roles'], ['cashier', 'receiver']);
+          return _reply({'employeeId': _worker, 'displayName': 'Камола Н.',
+            'roles': body['roles'], 'active': true, 'version': 1});
+        }
+        if (request.url.path == '$_base/registers') {
+          issuedKey = body['registerKey'] as String;
+          expect(issuedKey, matches(r'^[a-f0-9]{64}$'));
+          return _reply({'registerId': body['registerId'], 'name': body['name'],
+            'active': true, 'version': 1, 'cashierIds': [_owner]});
+        }
+        expect(request.url.path, startsWith('$_base/registers/'));
+        expect(request.url.path, endsWith('/cashiers'));
+        expect(body['expectedVersion'], 1);
+        expect(body['cashierIds'], [_owner, _worker]);
+        return _reply({'registerId': request.url.pathSegments[4], 'name': 'Телефон',
+          'active': true, 'version': 2, 'cashierIds': body['cashierIds']});
+      }),
+    );
+    final location = KassaLocation(_store, null);
+    final host = root.forWorkplace(location);
+    final session = await host.api.signInOperator(
+      const StoreOperator(_owner, 'Владелец', {Desk.admin, Desk.cashier, Desk.receiving}, isOwner: true), null);
+    final pos = root.forWorkplace(location, operator: session);
+    final employees = OperatorManagementApi(pos);
+    final employee = await employees.createEmployee(
+      _worker, 'Камола', 'Н.', {Desk.cashier, Desk.receiving}, '02468135');
+    final devices = StoreManagementApi(pos);
+    final issue = await devices.createRegister('Телефон', _owner);
+    await pos.api.setOperatorTerminal(issue.register, issuedKey: issue.key);
+    await devices.acknowledgeKey(issue);
+    final device = await employees.assignCashiers(issue.register, {_owner, employee.id});
+    final terminal = await host.api.operatorTerminal();
+    expect(terminal?.id, device.id);
+    expect(await host.api.savedRegisterKey(device.id), issuedKey);
+    expect(await devices.hasPendingKey(), false);
+    final data = await storage.readAll();
+    expect(data.values, isNot(contains('02468135')));
+    expect(data.values, isNot(contains(_ownerToken)));
+    root.api.close();
+  });
+}
