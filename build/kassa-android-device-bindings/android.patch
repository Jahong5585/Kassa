+      }
+    } on FormatException {
+      // A broken or revoked binding must never enable the legacy credential.
+    }
+    return {'active': false};
+  }
+
+  Future<bool> hasRegisterCredential(String id) async {
+    final binding = await _savedDeviceBinding(id);
+    return binding != null ? binding['active'] == true : await savedRegisterKey(id) != null;
+  }
+
+  Future<void> _invalidateDeviceBinding(String id, {String? token}) async {
+    final saved = await _savedDeviceBinding(id);
+    if (token != null && saved?['token'] != token) return;
+    // Keep a tombstone so a rejected device token cannot fall back to an old key.
+    await login._storage.write(key: _deviceBindingKey(id), value: '{"active":false}');
+  }
+
