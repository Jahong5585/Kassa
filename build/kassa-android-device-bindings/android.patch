+
+extension RegisterDeviceAccess on ServerApi {
+  Future<String> installationDeviceId() async {
+    final key = 'kassa.operator.device.v1.${origin.origin}';
+    final saved = await login._storage.read(key: key);
+    if (_assignedId(saved)) return saved!;
+    final id = newId();
+    await login._storage.write(key: key, value: id);
+    _ensureWorkplace();
+    return id;
+  }
+
+  String _deviceBindingKey(String id) => KassaLocation(storeId, id)
+      .storageKey(origin.origin, login.subject, Desk.cashier, 'register-device-binding');
+
+  Future<Json?> _savedDeviceBinding(String id) async {
+    _ensureWorkplace();
+    final value = await login._storage.read(key: _deviceBindingKey(id));
+    _ensureWorkplace();
+    if (value == null) return null;
+    try {
+      final data = jsonDecode(value);
+      if (data is Json && data['active'] == true &&
+          data['registerId'] == id && data['storeId'] == storeId &&
+          _assignedId(data['bindingId']) &&
+          data['deviceId'] == await installationDeviceId() &&
+          data['name'] is String &&
+          data['token'] is String &&
+          RegExp(r'^[a-zA-Z0-9_-]{32,256}$').hasMatch(data['token'] as String)) {
