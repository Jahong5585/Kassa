+import 'dart:convert';
+
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:kassa_mobile/pos.dart';
+
+const store = '41000000-0000-4000-8000-000000000001';
+const register = '41000000-0000-4000-8000-000000000002';
+const owner = '41000000-0000-4000-8000-000000000003';
+const worker = '41000000-0000-4000-8000-000000000004';
+const binding = '41000000-0000-4000-8000-000000000005';
+const organization = '41000000-0000-4000-8000-000000000006';
+const session = '41000000-0000-4000-8000-000000000007';
+const device = '41000000-0000-4000-8000-000000000008';
+const otherDevice = '41000000-0000-4000-8000-000000000009';
+const prefix = '/v1/stores/$store/registers/$register/device-bindings';
+final token = 'x' * 43;
+final legacyKey = 'a' * 64;
+
+class Host extends Login {
+  Host(super.storage, {this.account = 'owner-account'});
+  final String account;
+  @override
+  String get subject => account;
+  @override
+  Future<String> accessToken({bool force = false}) async => 'host-bearer';
+}
+
+http.Response reply(Object? data, [int status = 200]) =>
+    http.Response(jsonEncode(data), status, headers: {'content-type': 'application/json'});
+
+Json operatorData(bool isOwner) => {
+  'operatorId': isOwner ? owner : worker, 'displayName': isOwner ? 'Owner' : 'Worker',
+  'isOwner': isOwner, 'passwordRequired': !isOwner, 'active': true,
+  'roles': isOwner ? ['admin', 'cashier', 'receiver'] : ['cashier', 'receiver'],
+};
+Json bindingData() => {'bindingId': binding, 'storeId': store, 'registerId': register,
+  'deviceId': device, 'deviceName': 'Phone', 'registerDeviceToken': token, 'version': 1};
+Json allowed({bool assigned = true, String? bindingId = binding}) => {'items': [
+  {'registerId': register, 'name': 'Existing till', 'active': true, 'version': 1,
+    'assigned': assigned, 'boundToCurrentDevice': bindingId != null, 'bindingId': bindingId},
+]};
+final StoreRegister till = (id: register, name: 'Existing till', active: true, version: 1, cashiers: [owner, worker]);
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  const storage = FlutterSecureStorage();
+  late Pos root;
+  late Pos host;
+  late String origin;
+  var failBinding = false;
+  var revoked = false;
+  var assigned = true;
+  var bindingId = binding;
+  var cashRequests = 0;
+  var bindingRequests = 0;
+  var responseDevice = device;
+  var bindingStatus = 200;
+  final sent = <http.Request>[];
+
+  Future<Pos> signIn({bool isOwner = true}) async {
+    final opened = await host.api.signInOperator(StoreOperator(isOwner ? owner : worker,
+        'User', isOwner ? {Desk.admin, Desk.cashier, Desk.receiving} : {Desk.cashier, Desk.receiving},
+        isOwner: isOwner), isOwner ? null : '12345678');
+    expect(opened.hasRegisterContract, true);
+    expect(opened.registerId, register);
+    return root.forWorkplace(KassaLocation(store, register), operator: opened);
+  }
+
+  setUp(() async {
+    failBinding = false; revoked = false; assigned = true; bindingId = binding;
+    responseDevice = device; bindingStatus = 200; cashRequests = 0; bindingRequests = 0; sent.clear();
+    root = Pos(storage, login: Host(storage), productionContract: true,
+      client: MockClient((request) async {
+        sent.add(request);
+        expect(request.headers['Authorization'], 'Bearer host-bearer');
+        if (request.url.path == '/v1/stores/$store/operator-sessions') {
+          final body = jsonDecode(request.body) as Json;
+          expect(body['deviceId'], device);
+          final isOwner = body['operatorId'] == owner;
+          return reply({'storeId': store, 'organizationId': organization, 'sessionId': session,
+            'registerId': register, 'operatorSessionToken': (isOwner ? 'o' : 'w') * 43,
+            'operator': operatorData(isOwner)});
+        }
+        if (request.url.path == '/v1/operator-sessions/current/registers') {
+          expect(request.headers['X-Register-Key'], isNull);
+          expect(request.headers['X-Register-Device-Token'], isNull);
+          expect(request.headers['X-Active-Role'], 'cashier');
+          return reply(allowed(assigned: assigned, bindingId: bindingId));
+        }
+        if (request.url.path == prefix) {
+          expect(request.headers['X-Active-Role'], 'admin');
+          expect(request.headers['X-Operator-Session'], 'o' * 43);
+          if (request.method == 'GET') return reply([
+            {...(bindingData()..remove('registerDeviceToken')), 'revokedAt': null},
+          ]);
+          bindingRequests++;
+          if (bindingStatus != 200) return reply({'code': 'register_device_binding_shift_open'}, bindingStatus);
+          return reply({...bindingData(), 'deviceId': responseDevice});
+        }
+        if (request.url.path == '$prefix/$binding/revoke') {
+          expect(jsonDecode(request.body), {'expectedVersion': 1,
+            'reason': 'Отключение устройства владельцем в Android'});
+          revoked = true;
+          return http.Response('', 204);
+        }
+        if (request.url.path == '/v1/operator-sessions/current') return http.Response('', 204);
+        if (request.url.path == '/v1/shifts/active') {
+          cashRequests++;
+          expect(request.headers['X-Register-Id'], register);
+          if (request.headers['X-Register-Device-Token'] != null) {
+            expect(request.headers['X-Register-Device-Token'], token);
+            expect(request.headers['X-Register-Key'], isNull);
+          } else {
+            expect(request.headers['X-Register-Key'], legacyKey);
+          }
+          return failBinding || revoked
+              ? reply({'code': 'register_device_binding_invalid'}, 403) : reply({'shift': null});
+        }
+        fail('Unexpected route ${request.method} ${request.url.path}');
+      }),
+    );
+    host = root.forWorkplace(KassaLocation(store, null));
+    origin = root.api.origin.origin;
+    FlutterSecureStorage.setMockInitialValues({'kassa.operator.device.v1.$origin': device});
+  });
+  tearDown(() => root.api.close());
+
+  test('existing register binds once, restores for staff, survives logout and prefers device token', () async {
+    final admin = await signIn();
+    await admin.api.setOperatorTerminal(till, issuedKey: legacyKey);
+    await admin.api.bindRegisterDevice(till);
+    expect(bindingRequests, 1);
+    expect(await admin.api.savedRegisterKey(register), legacyKey);
+    await admin.api.closeOperatorSession(Desk.admin);
+    final staff = await signIn(isOwner: false);
+    expect((await staff.api.resolveOperatorTerminal())?.id, register);
+    await staff.api.currentShift();
+    expect(sent.last.headers['X-Operator-Session'], 'w' * 43);
+    expect(bindingRequests, 1);
+    expect((await host.api.operatorTerminal())?.name, 'Existing till');
+  });
+
+  test('revoked device token is removed and cannot fall back to a retained legacy key', () async {
+    final admin = await signIn();
+    await admin.api.setOperatorTerminal(till, issuedKey: legacyKey);
+    await admin.api.bindRegisterDevice(till);
+    failBinding = true;
+    await expectLater(admin.api.currentShift(), throwsA(isA<ApiFailure>().having((e) => e.code,
+        'code', 'register_device_binding_invalid')));
+    expect(cashRequests, 1);
+    expect(await host.api.operatorTerminal(), isNull);
+    expect((await storage.readAll()).values.any((v) => v.contains(token)), false);
+    await expectLater(admin.api.currentShift(), throwsA(isA<ApiFailure>()));
+    expect(cashRequests, 1, reason: 'No retry with X-Register-Key after rejection');
+    expect(await admin.api.savedRegisterKey(register), legacyKey);
+    failBinding = false;
+    await admin.api.bindRegisterDevice(till);
+    await admin.api.currentShift();
+    expect(cashRequests, 2);
+  });
+
+  test('owner lists and revokes one device without removing the register or general key', () async {
+    final admin = await signIn();
+    await admin.api.setOperatorTerminal(till, issuedKey: legacyKey);
+    await admin.api.bindRegisterDevice(till);
+    final rows = await admin.api.registerDeviceBindings(register);
+    expect(rows.single.deviceId, device);
+    await admin.api.revokeRegisterDevice(rows.single);
+    expect(revoked, true);
+    expect(await host.api.operatorTerminal(), isNull);
+    expect(await host.api.savedRegisterKey(register), legacyKey);
+    await expectLater(admin.api.currentShift(), throwsA(isA<ApiFailure>()));
+    expect(cashRequests, 0);
+  });
+
+  test('staff cannot create, list or revoke device bindings', () async {
+    final staff = await signIn(isOwner: false);
+    final before = sent.length;
+    await expectLater(staff.api.bindRegisterDevice(till), throwsA(isA<ApiFailure>()));
+    await expectLater(staff.api.registerDeviceBindings(register), throwsA(isA<ApiFailure>()));
+    await expectLater(staff.api.revokeRegisterDevice(const RegisterDeviceBinding(
+        binding, register, device, 'Phone', 1, revoked: false)), throwsA(isA<ApiFailure>()));
+    expect(sent.length, before);
+  });
+
+  test('unassigned employee and mismatched binding cannot restore the till', () async {
+    final admin = await signIn();
+    await admin.api.bindRegisterDevice(till);
+    final staff = await signIn(isOwner: false);
+    assigned = false;
+    expect(await staff.api.resolveOperatorTerminal(), isNull);
+    expect(await host.api.operatorTerminal(), isNotNull, reason: 'Other assigned cashiers retain the phone binding');
+    assigned = true;
+    bindingId = otherDevice;
+    expect(await staff.api.resolveOperatorTerminal(), isNull);
+  });
+
+  test('server cannot save a binding for another installation and conflicts preserve existing credentials', () async {
+    final admin = await signIn();
+    responseDevice = otherDevice;
+    await expectLater(admin.api.bindRegisterDevice(till), throwsA(isA<ApiFailure>()));
+    expect(await host.api.operatorTerminal(), isNull);
+    responseDevice = device;
+    await admin.api.bindRegisterDevice(till);
+    bindingStatus = 409;
+    await expectLater(admin.api.bindRegisterDevice(till), throwsA(isA<ApiFailure>().having((e) => e.code,
+        'code', 'register_device_binding_shift_open')));
+    expect((await host.api.operatorTerminal())?.id, register);
+  });
+
+  test('binding belongs to the owner account, store and stable installation', () async {
+    final admin = await signIn();
+    await admin.api.bindRegisterDevice(till);
+    final anotherAccount = Pos(storage, login: Host(storage, account: 'another'), productionContract: true)
+        .forWorkplace(KassaLocation(store, register));
+    expect(await anotherAccount.api.operatorTerminal(), isNull);
+    expect(await root.forWorkplace(KassaLocation(organization, register)).api.operatorTerminal(), isNull);
+    await storage.write(key: 'kassa.operator.device.v1.$origin', value: otherDevice);
+    expect(await host.api.operatorTerminal(), isNull);
+  });
+
+  test('saved legacy key still works before migration', () async {
+    final admin = await signIn();
+    await admin.api.setOperatorTerminal(till, issuedKey: legacyKey);
+    await admin.api.currentShift();
+    expect(sent.last.headers['X-Register-Key'], legacyKey);
+    expect(bindingRequests, 0);
+  });
+}
