+    if (!opened.operator.roles.contains(Desk.cashier)) return null;
+    final terminal = await operatorTerminal();
+    // Old servers do not advertise registerId. Preserve already saved legacy keys.
+    if (!opened.hasRegisterContract &&
+        (terminal == null || await _savedDeviceBinding(terminal.id) == null)) {
+      return terminal;
+    }
+    final data = await request('GET', '/v1/operator-sessions/current/registers', desk: Desk.cashier);
+    if (data is! Json || data['items'] is! List) throw ApiFailure(0, 'invalid_server_response');
+    final seen = <String>{};
+    AssignedRegister? bound;
+    var legacyAllowed = false;
+    for (final row in data['items'] as List) {
+      if (row is! Json || !_assignedId(row['registerId']) || row['name'] is! String ||
+          row['active'] is! bool || row['assigned'] is! bool ||
+          row['boundToCurrentDevice'] is! bool || !seen.add(row['registerId'] as String) ||
+          (row['bindingId'] != null && !_assignedId(row['bindingId']))) {
+        throw ApiFailure(0, 'invalid_server_response');
+      }
+      if (row['active'] != true || row['assigned'] != true) continue;
+      final id = row['registerId'] as String;
+      final local = await _savedDeviceBinding(id);
+      if (id == terminal?.id && local == null) legacyAllowed = true;
+      if (row['boundToCurrentDevice'] == true) {
+        if (bound != null || row['bindingId'] == null) throw ApiFailure(0, 'invalid_server_response');
+        if (local?['active'] == true && local?['bindingId'] == row['bindingId']) {
+          bound = AssignedRegister(id, row['name'] as String);
+        }
+      }
+    }
+    return bound ?? (legacyAllowed ? terminal : null);
+  }
+}
