+      throw ApiFailure(403, 'owner_access_required');
+    }
+  }
+
+  Future<void> bindRegisterDevice(StoreRegister register) async {
+    _requireBindingOwner();
+    if (!register.active) throw ApiFailure(409, 'register_disabled');
+    final deviceId = await installationDeviceId();
+    final data = await request('POST', '$store/registers/${register.id}/device-bindings',
+      desk: Desk.admin,
+      body: {'deviceName': 'Android · ${register.name}'.substring(0,
+          min(120, 'Android · ${register.name}'.length)),
+        'reason': 'Подключение телефона к существующей кассе'},
+    );
+    if (data is! Json || !_assignedId(data['bindingId']) ||
+        data['storeId'] != storeId || data['registerId'] != register.id ||
+        data['deviceId'] != deviceId || data['version'] is! int ||
+        (data['version'] as int) < 1 || data['registerDeviceToken'] is! String ||
+        !RegExp(r'^[a-zA-Z0-9_-]{32,256}$').hasMatch(data['registerDeviceToken'] as String)) {
+      throw ApiFailure(0, 'invalid_server_response');
+    }
+    _ensureWorkplace();
+    await login._storage.write(key: _deviceBindingKey(register.id), value: jsonEncode({
+      'active': true, 'storeId': storeId, 'registerId': register.id,
+      'bindingId': data['bindingId'], 'deviceId': deviceId,
+      'name': register.name, 'token': data['registerDeviceToken'],
+    }));
+    _ensureWorkplace();
+    await login._storage.write(key: _terminalKey,
+        value: jsonEncode({'id': register.id, 'name': register.name}));
+  }
+
+  Future<List<RegisterDeviceBinding>> registerDeviceBindings(String register) async {
+    _requireBindingOwner();
+    if (!_assignedId(register)) throw ApiFailure(0, 'invalid_api_path');
+    final result = <RegisterDeviceBinding>[];
+    final seen = <String>{};
+    for (var offset = 0;; offset += 50) {
+      final data = await request('GET', '$store/registers/$register/device-bindings',
+          desk: Desk.admin, query: {'offset': '$offset', 'limit': '50'});
+      if (data is! List || data.length > 50) throw ApiFailure(0, 'invalid_server_response');
+      for (final row in data) {
+        if (row is! Json || !_assignedId(row['bindingId']) ||
+            row['storeId'] != storeId || row['registerId'] != register ||
+            !_assignedId(row['deviceId']) || row['deviceName'] is! String ||
+            row['version'] is! int || (row['version'] as int) < 1 ||
+            !seen.add(row['bindingId'] as String)) {
+          throw ApiFailure(0, 'invalid_server_response');
+        }
+        result.add(RegisterDeviceBinding(row['bindingId'] as String, register,
+            row['deviceId'] as String, row['deviceName'] as String,
+            row['version'] as int, revoked: row['revokedAt'] != null));
+      }
+      if (data.length < 50) return result;
+    }
+  }
+
+  Future<void> revokeRegisterDevice(RegisterDeviceBinding binding) async {
+    _requireBindingOwner();
+    await request('POST', '$store/registers/${binding.registerId}/device-bindings/${binding.id}/revoke',
+        desk: Desk.admin, body: {'expectedVersion': binding.version,
+          'reason': 'Отключение устройства владельцем в Android'});
