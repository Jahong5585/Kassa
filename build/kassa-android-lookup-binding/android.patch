+  Future<Json?> existingByBarcode(String code) async {
+    const pageSize = 25;
+    for (var offset = 0; offset <= 10000; offset += pageSize) {
+      final rows = await search(code, offset, admin: true, includeArchived: true);
+      for (final row in rows) {
+        final id = row['productId'];
+        if (id is! String) throw ApiFailure(0, 'invalid_server_response');
+        final Json card;
+        try {
+          card = await product(id);
+        } on ApiFailure catch (failure) {
+          if (failure.code != 'product_not_found') rethrow;
+          continue;
+        }
+        final barcodes = card['barcodes'];
+        if (barcodes is! List) throw ApiFailure(0, 'invalid_server_response');
+        if (barcodes.any((entry) => entry is Json && entry['code'] == code)) {
+          return card;
+        }
+      }
+      if (rows.length < pageSize) return null;
+    }
+    throw ApiFailure(0, 'invalid_server_response');
+  }
