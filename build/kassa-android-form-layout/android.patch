+import 'dart:convert';
+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:kassa_mobile/main.dart';
+import 'package:kassa_mobile/pos.dart';
+
+class _LayoutLogin extends Login {
+  _LayoutLogin(super.storage);
+
+  @override
+  String get subject => 'layout-admin-fixture';
+
+  @override
+  Future<void> signIn() async {}
+
+  @override
+  Future<String> accessToken({bool force = false}) async => 'fixture-token';
+}
+
+Future<void> _loadPreviewFont(String family, String variable) async {
+  final path = Platform.environment[variable];
+  if (path == null || path.isEmpty) return;
+  final loader = FontLoader(family)
+    ..addFont(Future.value(ByteData.sublistView(File(path).readAsBytesSync())));
+  await loader.load();
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  final preview = Platform.environment['KASSA_FORM_PREVIEW'];
+
+  setUpAll(() async {
+    if (preview == null) return;
+    await _loadPreviewFont('Roboto', 'KASSA_PREVIEW_TEXT_FONT');
+    await _loadPreviewFont('MaterialIcons', 'KASSA_PREVIEW_ICONS');
+  });
+
+  testWidgets('compact product editor retains details and shared spacing is used by suppliers and expenses',
+      (tester) async {
+    tester.view.devicePixelRatio = 1;
+    tester.view.physicalSize = const Size(390, 780);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    addTearDown(tester.view.resetPhysicalSize);
+    FlutterSecureStorage.setMockInitialValues({'kassa.ui.language': 'uz'});
+    const storage = FlutterSecureStorage();
+    const store = '/v1/stores/$testStore';
+    const catalog = '$store/catalog/products';
+    Json? card;
+    http.Response response(Object value) => http.Response.bytes(
+      utf8.encode(jsonEncode(value)),
+      200,
+      headers: {'content-type': 'application/json; charset=utf-8'},
+    );
+    final pos = Pos(
+      storage,
+      login: _LayoutLogin(storage),
+      client: MockClient((request) async {
+        final path = request.url.path;
+        switch (path) {
+          case '/v1/me/roles':
+            return response({'storeId': testStore, 'roles': ['admin']});
+          case '$store/receiving/catalog/proposals':
+          case '$store/suppliers':
+          case catalog:
+            return response([]);
+          case '$store/finance/expenses':
+            final query = request.url.queryParameters;
+            return response({
+              'storeId': testStore,
+              'from': query['from'],
+              'to': query['to'],
+              'category': query['category'],
+              'includeReversed': false,
+              'items': [],
+            });
+        }
+        if (path.startsWith('$catalog/')) {
+          if (request.method == 'PUT') {
+            card = {
+              ...(jsonDecode(request.body) as Json),
+              'productId': request.url.pathSegments.last,
+              'version': 1,
+              'active': true,
+            };
+          }
+          return response(card!);
+        }
+        fail('Unexpected request $path');
+      }),
+    );
+    addTearDown(pos.api.close);
+    final boundary = GlobalKey();
+
+    Future<void> tap(Finder finder) async {
+      await tester.ensureVisible(finder);
+      await tester.pumpAndSettle();
+      await tester.tap(finder);
+      await tester.pumpAndSettle();
+    }
+    Future<void> destination(String label) =>
+        tap(find.widgetWithText(NavigationDestination, label));
+
+    Future<void> capture(String filename) async {
+      if (preview == null) return;
+      await tester.runAsync(() async {
+        final render = boundary.currentContext!.findRenderObject() as RenderRepaintBoundary;
+        final screenshot = await render.toImage(pixelRatio: 2);
+        try {
+          final bytes = await screenshot.toByteData(format: ui.ImageByteFormat.png);
+          final file = File('$preview/$filename.png');
+          file.parent.createSync(recursive: true);
+          file.writeAsBytesSync(bytes!.buffer.asUint8List());
+        } finally {
+          screenshot.dispose();
+        }
+      });
+    }
+
+    await tester.pumpWidget(RepaintBoundary(key: boundary, child: KassaApp(pos: pos, debugPilot: true)));
+    await tester.pumpAndSettle();
+    await tap(find.text('Hisobga kirish'));
+    await destination('Tovarlar');
+    await tap(find.text('Tovarlar katalogi'));
+    await tap(find.text('Tovar qo‘shish'));
+    expect(find.text('Yangi tovar'), findsOneWidget);
+    expect(find.text('Новый товар'), findsNothing);
+    final save = find.text('Kartochkani saqlash');
+    final details = find.text('Qo‘shimcha ma’lumotlar');
+    expect(save.hitTestable(), findsOneWidget);
+    expect(find.text('Soliq profili').hitTestable(), findsNothing);
+    expect(details.hitTestable(), findsOneWidget);
+    await capture('01-product');
+
+    await tap(save);
+    expect(find.text('Tovar nomini kiriting.'), findsOneWidget);
+    await tester.enterText(find.widgetWithText(TextFormField, 'Nomi'), 'Sinov choyi');
+    FocusManager.instance.primaryFocus?.unfocus();
+    await tester.pumpAndSettle();
+    await tap(details);
+    final category = find.widgetWithText(TextFormField, 'Toifa');
+    expect(category, findsOneWidget);
+    await tester.ensureVisible(category);
+    await tester.pumpAndSettle();
+    await tester.enterText(category, 'Ichimliklar');
+    FocusManager.instance.primaryFocus?.unfocus();
+    await tester.pumpAndSettle();
+    await tap(details);
+    await tap(save);
+    expect(card?['name'], 'Sinov choyi');
+    expect(card?['category'], 'Ichimliklar');
+    expect(card?['unit'], 'piece');
+    expect(card?['barcodes'], isEmpty);
+
+    await tester.pageBack();
+    await tester.pumpAndSettle();
+    await tester.pageBack();
+    await tester.pumpAndSettle();
+    await tap(find.text('Yetkazib beruvchilar'));
+    await tap(find.text('Yetkazib beruvchi qo‘shish'));
+    expect(find.text('Yangi yetkazib beruvchi'), findsOneWidget);
+    final supplierName = find.widgetWithText(TextFormField, 'Nomi');
+    final taxId = find.widgetWithText(TextFormField, 'STIR');
+    expect(tester.getTopLeft(taxId).dy - tester.getBottomLeft(supplierName).dy, greaterThanOrEqualTo(10));
+    await capture('02-supplier');
+
+    await tester.pageBack();
+    await tester.pumpAndSettle();
+    await tester.pageBack();
+    await tester.pumpAndSettle();
+    await destination('Do‘kon');
+    await tap(find.text('Do‘kon xarajatlari'));
+    await tap(find.text('Xarajat qo‘shish'));
+    expect(find.text('Yangi xarajat'), findsOneWidget);
+    await capture('03-expense');
+    expect(tester.takeException(), isNull);
+  });
+}
