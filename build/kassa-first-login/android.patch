+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:kassa_mobile/main.dart';
+import 'package:kassa_mobile/pos.dart';
+
+const storage = FlutterSecureStorage();
+const code = 'ABCDEF0123456789ABCDEF01';
+final opaque = 'ksm_${'A' * 64}';
+
+http.Response response(Object body, {int status = 200}) =>
+    http.Response(jsonEncode(body), status);
+
+http.Response tokens([String subject = 'existing-cashier']) =>
+    response({'accessToken': opaque, 'subject': subject, 'expiresIn': 600});
+
+void main() {
+  setUp(() => FlutterSecureStorage.setMockInitialValues({}));
+
+  test('first login stays on the Kassa API and reuses enrollment proof after a timeout', () async {
+    final proofs = <String>[];
+    final client = MockClient((request) async {
+      expect(request.method, 'POST');
+      expect(request.followRedirects, isFalse);
+      expect(request.url.host, Uri.parse(apiOrigin).host);
+      expect(request.url.path, '/v1/mobile/auth/redeem');
+      final json = jsonDecode(request.body) as Map<String, dynamic>;
+      expect(json['code'], code);
+      final proof = json['deviceCredential'] as String;
+      expect(proof, matches('^[a-f0-9]{64}$'));
+      proofs.add(proof);
+      return proofs.length == 1 ? response({}, status: 503) : tokens();
+    });
+    final login = Login(storage, invitationClient: client, useNativeInvitation: true);
+    await expectLater(login.signInWithInvitation(code), throwsA(isA<ApiFailure>()));
+    expect(await storage.readAll(), isEmpty);
+    await login.signInWithInvitation('abcdef-0123456789-abcdef01');
+    expect(proofs.last, proofs.first);
+    expect(login.subject, 'existing-cashier');
+    expect(await login.accessToken(), opaque);
+    expect((await storage.readAll()).values.single, isNot(contains(code)));
+  });
+
+  test('new instance restores mobile credentials and log out revokes the device', () async {
+    final paths = <String>[];
+    String? proof;
+    final client = MockClient((request) async {
+      paths.add(request.url.pathSegments.last);
+      final current = (jsonDecode(request.body) as Map)['deviceCredential'];
+      proof ??= current as String;
+      expect(current, proof);
+      return paths.last == 'revoke' ? http.Response('', 204) : tokens();
+    });
+    await Login(storage, invitationClient: client).signInWithInvitation(code);
+    final restarted = Login(storage, invitationClient: client);
+    expect(await restarted.restore(), isTrue);
+    expect(restarted.subject, 'existing-cashier');
+    expect(await restarted.signOutAndRevoke(), isTrue);
+    expect(paths, ['redeem', 'renew', 'revoke']);
+    expect(await storage.readAll(), isEmpty);
+  });
+
+  test('redirects and an invalid code cannot save a session', () async {
+    final login = Login(storage, invitationClient: MockClient((request) async {
+      expect(request.followRedirects, isFalse);
+      return http.Response('', 302, headers: {'location': 'https://example.com'});
+    }));
+    await expectLater(login.signInWithInvitation(code), throwsA(isA<ApiFailure>()));
+    expect(await storage.readAll(), isEmpty);
+  });
+
+  testWidgets('enter invitation in app, retry bad code, then see assigned stores', (tester) async {
+    var requests = 0;
+    final login = Login(storage, useNativeInvitation: true, invitationClient: MockClient((request) async {
+      expect(request.url.path, '/v1/mobile/auth/redeem');
+      return ++requests == 1 ? response({}, status: 401) : tokens();
+    }));
+    final app = Pos(storage, login: login, productionContract: true, client: MockClient((request) async {
+      expect(request.url.path, '/v1/me/stores');
+      expect(request.headers.entries.singleWhere((entry) => entry.key.toLowerCase() == 'authorization').value, 'Bearer $opaque');
+      return response({
+        'items': [{
+          'storeId': '30000000-0000-4000-8000-000000000001',
+          'name': 'Доступный магазин',
+          'timeZone': 'Asia/Tashkent',
+          'utcOffsetMinutes': 300,
+          'registers': [],
+        }],
+        'nextOffset': null,
+      });
+    }));
+    await tester.pumpWidget(KassaApp(pos: app));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Войти'));
+    await tester.pumpAndSettle();
+    expect(find.text('Вход по приглашению'), findsOneWidget);
+    await tester.enterText(find.byType(TextField), code);
+    await tester.tap(find.text('Подтвердить'));
+    await tester.pumpAndSettle();
+    expect(find.textContaining('Код неверный'), findsOneWidget);
+    await tester.tap(find.text('Подтвердить'));
+    await tester.pumpAndSettle();
+    expect(find.text('Доступный магазин'), findsOneWidget);
+    expect(find.text('Вход по приглашению'), findsNothing);
+  });
+}
