+Future<bool> _showMobileInvitation(BuildContext context, Login login) async =>
+    await showDialog<bool>(
+      context: context,
+      barrierDismissible: false,
+      builder: (context) => _MobileInvitationDialog(login: login),
+    ) ?? false;
+
+class _MobileInvitationDialog extends StatefulWidget {
+  const _MobileInvitationDialog({required this.login});
+
+  final Login login;
+
+  @override
+  State<_MobileInvitationDialog> createState() => _MobileInvitationDialogState();
+}
+
+class _MobileInvitationDialogState extends State<_MobileInvitationDialog> {
+  final _code = TextEditingController();
+  bool _busy = false;
+  String? _error;
+
+  Future<void> _submit() async {
+    if (_busy) return;
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    try {
+      await widget.login.signInWithInvitation(_code.text);
+      if (mounted) Navigator.of(context).pop(true);
+    } on ApiFailure catch (failure) {
+      if (mounted) setState(() => _error = _apiMessage(context, failure));
+    } on Exception {
+      if (mounted) {
+        setState(() => _error = _tr(context, 'Вход не завершён. Повторите попытку.',
+            'Kirish yakunlanmadi. Qayta urinib ko‘ring.'));
+      }
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  @override
+  void dispose() {
+    _code.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => PopScope(
+    canPop: !_busy,
+    child: AlertDialog(
+      title: const _UiText('Вход по приглашению', 'Taklif orqali kirish'),
+      content: SingleChildScrollView(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            const _UiText('Введите код, выданный администратором.',
+                'Administrator bergan kodni kiriting.'),
+            const SizedBox(height: 12),
+            TextField(
+              controller: _code,
+              autofocus: true,
+              enabled: !_busy,
+              obscureText: true,
+              enableSuggestions: false,
+              autocorrect: false,
+              maxLength: 40,
+              textInputAction: TextInputAction.done,
+              onSubmitted: (_) => _submit(),
+              decoration: InputDecoration(
+                labelText: _tr(context, 'Код приглашения', 'Taklif kodi'),
+                errorText: _error,
+                errorMaxLines: 3,
+              ),
+            ),
+            if (_busy) const LinearProgressIndicator(),
+          ],
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: _busy ? null : () => Navigator.of(context).pop(false),
+          child: const _UiText('Отмена', 'Bekor qilish'),
+        ),
+        FilledButton(
+          onPressed: _busy ? null : _submit,
+          child: const _UiText('Подтвердить', 'Tasdiqlash'),
+        ),
+      ],
+    ),
+  );
+}
