+part of 'pos.dart';
+
+typedef _InvitationSession = ({String token, String subject, DateTime expiresAt});
+
+extension MobileInvitationLogin on Login {
+  Future<void> signInWithInvitation(String input) async {
+    final code = input.trim().replaceAll(RegExp(r'[\s-]'), '').toUpperCase();
+    if (!RegExp(r'^[A-F0-9]{24}$').hasMatch(code)) {
+      throw ApiFailure(400, 'mobile_code_format');
+    }
+    if (_invitationBusy) throw ApiFailure(409, 'device_login_in_progress');
+    if (_invitationCode != code) {
+      final random = Random.secure();
+      _invitationCredential = List.generate(
+        32, (_) => random.nextInt(256).toRadixString(16).padLeft(2, '0'),
+      ).join();
+      _invitationCode = code;
+    }
+    final credential = _invitationCredential!;
+    final generation = _generation;
+    _invitationBusy = true;
+    try {
+      final session = await _invitationRequest('redeem', credential, code: code);
+      if (generation != _generation) throw const DeviceLoginCancelled();
+      await _saveSession(session.subject, credential, native: true);
+      if (generation != _generation) throw const DeviceLoginCancelled();
+      _generation++;
+      _persistent = true;
+      _native = true;
+      _subject = session.subject;
+      _refreshToken = credential;
+      _accessToken = session.token;
+      _expiresAt = session.expiresAt;
+      _clearInvitation();
+    } finally {
+      _invitationBusy = false;
+    }
+  }
+
+  void _clearInvitation() {
+    _invitationCredential = null;
+    _invitationCode = null;
+  }
+
+  Future<String> _refreshInvitation(String credential, String current, int generation) async {
+    final session = await _invitationRequest('renew', credential);
+    if (generation != _generation || session.subject != current || !_native) {
+      throw ApiFailure(401, 'sign_in_required');
+    }
+    _accessToken = session.token;
+    _expiresAt = session.expiresAt;
+    return session.token;
+  }
+
+  Future<_InvitationSession> _invitationRequest(
+    String action, String credential, {String? code}
+  ) async {
+    final response = await _postInvitation(action, credential, code: code);
+    if (response.statusCode == 401) {
+      throw ApiFailure(401, code == null ? 'sign_in_required' : 'mobile_code_invalid');
+    }
+    if (response.statusCode == 429) {
+      throw ApiFailure(429, 'device_login_rate_limited');
+    }
+    if (response.statusCode != 200) {
+      throw ApiFailure(response.statusCode, 'mobile_login_unavailable');
+    }
+    try {
+      final data = jsonDecode(utf8.decode(response.bodyBytes));
+      if (data is Json &&
+          data['accessToken'] is String &&
+          RegExp(r'^ksm_[A-Fa-f0-9]{64}$').hasMatch(data['accessToken'] as String) &&
+          data['subject'] is String &&
+          (data['subject'] as String).isNotEmpty &&
+          (data['subject'] as String).length <= 256 &&
+          data['expiresIn'] is int &&
+          (data['expiresIn'] as int) > 20 &&
+          (data['expiresIn'] as int) <= 600) {
+        return (
+          token: data['accessToken'] as String,
+          subject: data['subject'] as String,
+          expiresAt: DateTime.now().add(Duration(seconds: data['expiresIn'] as int)),
+        );
+      }
+    } on FormatException {
+      // A response without a valid session cannot authorize the client.
+    }
+    throw ApiFailure(0, 'invalid_server_response');
+  }
+
+  Future<http.Response> _postInvitation(
+    String action, String credential, {String? code}
+  ) async {
+    final origin = validateKassaOrigin(apiOrigin, debug: kDebugMode);
+    final request = http.Request('POST', origin.replace(path: '/v1/mobile/auth/$action'))
+      ..followRedirects = false
+      ..headers['content-type'] = 'application/json'
+      ..headers['accept'] = 'application/json'
+      ..body = jsonEncode({
+        if (code != null) 'code': code,
+        'deviceCredential': credential,
+      });
+    final client = _invitationClient ?? http.Client();
+    try {
+      return await client.send(request)
+          .then(http.Response.fromStream)
+          .timeout(const Duration(seconds: 10));
+    } on Exception {
+      throw ApiFailure(0, 'network');
+    } finally {
+      if (_invitationClient == null) client.close();
+    }
+  }
+}
