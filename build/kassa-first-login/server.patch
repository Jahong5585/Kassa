+"""Verify the native login API on the isolated PostgreSQL fixture."""
+from concurrent.futures import ThreadPoolExecutor
+from secrets import token_hex
+
+from smoke import fixture_id, request
+
+
+def main():
+    owner_id = fixture_id(3050)
+    issue_path = f"/v1/platform/organizations/{fixture_id(1)}/staff/{owner_id}/mobile"
+    auth = "/v1/mobile/auth"
+    operator = {"staff": "admin-platform-writer", "hardware": True}
+
+    request(issue_path + "/invitation", method="POST", expected=403)
+    request(issue_path + "/invitation", method="POST", staff="admin-platform-writer", expected=403)
+    request(issue_path + "/invitation", method="POST", **operator)
+    invite = request(issue_path + "/invitation", method="POST", **operator)
+    assert len(invite["code"]) == 24 and invite["expiresAt"]
+    print("PASS: invitation requires hardware-backed platform authorization")
+
+    # Use a distinct request for each device exactly once in the race.
+    from smoke import BASE
+    from urllib.request import Request, urlopen
+    from urllib.error import HTTPError
+    import json
+
+    def redeem_once(credential):
+        message = Request(BASE + auth + "/redeem", json.dumps({
+            "code": invite["code"], "deviceCredential": credential,
+        }).encode(), {"Content-Type": "application/json"})
+        try:
+            with urlopen(message, timeout=10) as reply:
+                return credential, reply.status, json.load(reply)
+        except HTTPError as error:
+            return credential, error.code, None
+
+    credentials = [token_hex(32), token_hex(32)]
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(redeem_once, credentials))
+    assert sorted(status for _, status, _ in results) == [200, 401], results
+    key = next(value for value, status, _ in results if status == 200)
+    _, retry_status, session = redeem_once(key)
+    assert retry_status == 200
+    assert session["subject"] == "admin-owner" and session["expiresIn"] == 600
+    mobile = {"bearer": session["accessToken"]}
+
+    stores = request("/v1/me/stores", **mobile)
+    assigned = {store["storeId"]: store for store in stores["items"]}
+    assert set(assigned) == {fixture_id(11), fixture_id(13)}, stores
+    assert assigned[fixture_id(11)]["registers"] == [{"registerId": fixture_id(21), "name": "А1"}], stores
+    assert assigned[fixture_id(13)]["registers"] == [], stores
+    roles = request(f"/v1/me/roles?storeId={fixture_id(11)}", **mobile)
+    assert roles["owner"] and set(roles["roles"]) == {"cashier", "receiver"}, roles
+    request(f"/v1/me/roles?storeId={fixture_id(12)}", **mobile, expected=404)
+    request("/v1/platform/me", **mobile, expected=403)
+    blocked = request(f"/v1/stores/{fixture_id(11)}/staff", **mobile, active_role="admin", expected=403)
+    assert blocked["code"] == "admin_mfa_required", blocked
+    print("PASS: single use under concurrency, safe retry, matching stores and restricted roles")
+
+    renewed = request(auth + "/renew", {"deviceCredential": key}, staff=None)
+    assert renewed["accessToken"] != session["accessToken"]
+    request("/v1/me/stores", **mobile, expected=401)
+    request("/v1/me/stores", bearer=renewed["accessToken"])
+    request(auth + "/revoke", {"deviceCredential": key}, staff=None, expected=204)
+    request("/v1/me/stores", bearer=renewed["accessToken"], expected=401)
+    request(auth + "/renew", {"deviceCredential": key}, staff=None, expected=401)
+
+    fresh = request(issue_path + "/invitation", method="POST", **operator)
+    request(issue_path + "/devices", method="DELETE", expected=204, **operator)
+    request(auth + "/redeem", {"code": fresh["code"], "deviceCredential": token_hex(32)},
+            staff=None, expected=401)
+    request(f"/v1/me/roles?storeId={fixture_id(11)}", staff="cashier-a")
+    print("PASS: stored device renewal, logout, account-wide revoke, and existing OIDC")
+
+
+if __name__ == "__main__":
+    main()
