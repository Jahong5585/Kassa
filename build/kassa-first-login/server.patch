+using System.Security.Claims;
+using System.Security.Cryptography;
+using System.Text.Encodings.Web;
+using System.Threading.RateLimiting;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.AspNetCore.RateLimiting;
+using Microsoft.Extensions.Options;
+using Npgsql;
+
+namespace Kasa.Api;
+
+internal sealed record MobileTicketRequest(string? Code, string? DeviceCredential);
+internal sealed record MobileDeviceRequest(string? DeviceCredential);
+internal sealed record MobileInvitation(string Code, DateTime ExpiresAt);
+internal sealed record MobileSession(string AccessToken, string Subject, int ExpiresIn);
+
+internal sealed class MobileInvitationAuth(NpgsqlDataSource source, IConfiguration configuration)
+{
+    internal const string Scheme = "KassaMobile";
+    internal const string Selector = "KassaBearer";
+    private const string Prefix = "ksm_";
+    private const int AccessSeconds = 600;
+
+    internal static string SelectScheme(HttpContext context)
+    {
+        var header = context.Request.Headers.Authorization.ToString();
+        return header.StartsWith("Bearer " + Prefix, StringComparison.OrdinalIgnoreCase)
+            ? Scheme : JwtBearerDefaults.AuthenticationScheme;
+    }
+
+    internal static void AddLimiter(RateLimiterOptions options) =>
+        options.AddPolicy("mobile-invitation", context => RateLimitPartition.GetFixedWindowLimiter(
+            context.Connection.RemoteIpAddress?.ToString() ?? "unknown",
+            _ => new FixedWindowRateLimiterOptions { PermitLimit = 20, Window = TimeSpan.FromMinutes(1) }));
+
+    internal static void Map(WebApplication app, RouteGroupBuilder platform)
+    {
+        var mobile = app.MapGroup("/v1/mobile/auth")
+            .AllowAnonymous().RequireRateLimiting("mobile-invitation");
+        mobile.MapPost("/redeem", async (MobileTicketRequest body, MobileInvitationAuth auth, CancellationToken ct) =>
+            TypedResults.Ok(await auth.Redeem(body, ct))).WithName("RedeemMobileInvitation");
+        mobile.MapPost("/renew", async (MobileDeviceRequest body, MobileInvitationAuth auth, CancellationToken ct) =>
+            TypedResults.Ok(await auth.Renew(body, ct))).WithName("RenewMobileAccess");
+        mobile.MapPost("/revoke", async (MobileDeviceRequest body, MobileInvitationAuth auth, CancellationToken ct) =>
+        {
+            await auth.Revoke(body, ct);
+            return TypedResults.NoContent();
+        }).WithName("RevokeMobileDevice");
+
+        var staff = platform.MapGroup("/organizations/{orgId:guid}/staff/{staffId:guid}/mobile");
+        staff.MapPost("/invitation", async (Guid orgId, Guid staffId, MobileInvitationAuth auth,
+            HttpContext context, CancellationToken ct) =>
+            TypedResults.Ok(await auth.Issue(orgId, staffId, context, ct))).WithName("IssueMobileInvitation");
+        staff.MapDelete("/devices", async (Guid orgId, Guid staffId, MobileInvitationAuth auth,
+            HttpContext context, CancellationToken ct) =>
+        {
+            await auth.RevokeAll(orgId, staffId, context, ct);
+            return TypedResults.NoContent();
+        }).WithName("RevokeStaffMobileDevices");
+    }
+
+    internal async Task<MobileInvitation> Issue(Guid org, Guid staff, HttpContext context, CancellationToken ct)
+    {
+        await using var db = await source.OpenConnectionAsync(ct);
+        await using var tx = await db.BeginTransactionAsync(ct);
+        var actor = await Access.RequirePlatform(db, tx, context, configuration, true, ct, hardware: true);
+        await using (var target = db.Sql(tx, """
+            SELECT 1 FROM staff u
+            WHERE (u.org_id, u.id) = ($1, $2) AND u.active AND u.subject IS NOT NULL
+              AND EXISTS (
+                  SELECT 1 FROM staff_roles r WHERE (r.org_id, r.staff_id) = (u.org_id, u.id)
+                  AND r.role IN ('owner', 'cashier', 'receiver'))
+              AND EXISTS (
+                  SELECT 1 FROM staff_stores s WHERE (s.org_id, s.staff_id) = (u.org_id, u.id) AND s.active)
+            FOR UPDATE
+            """, org, staff))
+        {
+            if (await target.ExecuteScalarAsync(ct) is null)
+                throw new PosError(404, "mobile_account_unavailable");
+        }
+        await db.Run(tx, ct, """
+            UPDATE mobile_invitations SET revoked_at = now()
+            WHERE (org_id, staff_id) = ($1, $2) AND used_at IS NULL AND revoked_at IS NULL
+            """, org, staff);
+        var code = Convert.ToHexString(RandomNumberGenerator.GetBytes(12));
+        await using var create = db.Sql(tx, """
+            INSERT INTO mobile_invitations (digest, org_id, staff_id, issuer_id)
+            VALUES ($1, $2, $3, $4) RETURNING expires_at
+            """, Digest(code, 24), org, staff, actor.Id);
+        var expires = (DateTime)(await create.ExecuteScalarAsync(ct))!;
+        await tx.CommitAsync(ct);
+        return new MobileInvitation(code, expires);
+    }
+
+    private async Task RevokeAll(Guid org, Guid staff, HttpContext context, CancellationToken ct)
+    {
+        await using var db = await source.OpenConnectionAsync(ct);
+        await using var tx = await db.BeginTransactionAsync(ct);
+        await Access.RequirePlatform(db, tx, context, configuration, true, ct, hardware: true);
+        await using (var target = db.Sql(tx, "SELECT 1 FROM staff WHERE (org_id, id) = ($1, $2) FOR UPDATE", org, staff))
+        {
+            if (await target.ExecuteScalarAsync(ct) is null)
+                throw new PosError(404, "mobile_account_unavailable");
+        }
+        await db.Run(tx, ct, """
+            UPDATE mobile_invitations SET revoked_at = now()
+            WHERE (org_id, staff_id) = ($1, $2) AND revoked_at IS NULL
+            """, org, staff);
+        await db.Run(tx, ct, """
+            UPDATE mobile_devices SET revoked_at = now()
+            WHERE (org_id, staff_id) = ($1, $2) AND revoked_at IS NULL
+            """, org, staff);
+        await tx.CommitAsync(ct);
+    }
+
+    internal async Task<MobileSession> Redeem(MobileTicketRequest request, CancellationToken ct)
+    {
+        var code = request.Code?.Trim();
+        var invitation = Digest(code, 24);
+        var credential = Digest(request.DeviceCredential, 64);
+        if (invitation is null || credential is null) throw new PosError(401, "mobile_code_invalid");
+        await using var db = await source.OpenConnectionAsync(ct);
+        await using var tx = await db.BeginTransactionAsync(ct);
+        // Keep the same lock order as issuance and account-wide revocation.
+        await using (var target = db.Sql(tx, """
+            SELECT 1 FROM staff u JOIN mobile_invitations i
+            ON (i.org_id, i.staff_id) = (u.org_id, u.id)
+            WHERE i.digest = $1 FOR KEY SHARE OF u
+            """, invitation))
+        {
+            if (await target.ExecuteScalarAsync(ct) is null)
+                throw new PosError(401, "mobile_code_invalid");
+        }
+        await using (var consume = db.Sql(tx, """
+            UPDATE mobile_invitations SET used_at = now()
+            WHERE digest = $1 AND used_at IS NULL AND revoked_at IS NULL AND expires_at > now()
+            RETURNING digest
+            """, invitation))
+        {
+            if (await consume.ExecuteScalarAsync(ct) is not null)
+            {
+                var inserted = await db.Run(tx, ct, """
+                    INSERT INTO mobile_devices (credential_digest, invitation_digest, org_id, staff_id)
+                    SELECT $1, i.digest, i.org_id, i.staff_id FROM mobile_invitations i WHERE i.digest = $2
+                    ON CONFLICT (credential_digest) DO NOTHING
+                    """, credential, invitation);
+                if (inserted != 1) throw new PosError(401, "mobile_code_invalid");
+            }
+        }
+
+        // The same phone can retry a lost response. A different credential cannot redeem a used code.
+        var session = await CreateAccess(db, tx, credential, invitation, ct);
+        if (session is null) throw new PosError(401, "mobile_code_invalid");
+        await tx.CommitAsync(ct);
+        return session;
+    }
+
+    internal async Task<MobileSession> Renew(MobileDeviceRequest request, CancellationToken ct)
+    {
+        var credential = Digest(request.DeviceCredential, 64);
+        if (credential is null) throw new PosError(401, "sign_in_required");
+        await using var db = await source.OpenConnectionAsync(ct);
+        await using var tx = await db.BeginTransactionAsync(ct);
+        var session = await CreateAccess(db, tx, credential, null, ct);
+        if (session is null) throw new PosError(401, "sign_in_required");
+        await tx.CommitAsync(ct);
+        return session;
+    }
+
+    private async Task Revoke(MobileDeviceRequest request, CancellationToken ct)
+    {
+        var credential = Digest(request.DeviceCredential, 64);
+        if (credential is null) return;
+        await using var db = await source.OpenConnectionAsync(ct);
+        await using var tx = await db.BeginTransactionAsync(ct);
+        await db.Run(tx, ct, """
+            UPDATE mobile_devices SET revoked_at = now()
+            WHERE credential_digest = $1 AND revoked_at IS NULL
+            """, credential);
+        await tx.CommitAsync(ct);
+    }
+
+    private static async Task<MobileSession?> CreateAccess(NpgsqlConnection db, NpgsqlTransaction tx,
+        byte[] credential, byte[]? invitation, CancellationToken ct)
+    {
+        var sql = """
+            SELECT u.subject FROM mobile_devices d
+            JOIN staff u ON (u.org_id, u.id) = (d.org_id, d.staff_id)
+            JOIN mobile_invitations i ON i.digest = d.invitation_digest
+            WHERE d.credential_digest = $1 AND d.revoked_at IS NULL AND d.expires_at > now()
+              AND u.active AND u.subject IS NOT NULL AND i.revoked_at IS NULL
+            """ + (invitation is null ? "" : " AND i.digest = $2 AND i.expires_at > now()") + " FOR UPDATE OF d";
+        await using var lookup = invitation is null ? db.Sql(tx, sql, credential) : db.Sql(tx, sql, credential, invitation);
+        if (await lookup.ExecuteScalarAsync(ct) is not string subject) return null;
+        var secret = Convert.ToHexString(RandomNumberGenerator.GetBytes(32));
+        await db.Run(tx, ct, """
+            INSERT INTO mobile_access_tokens (digest, credential_digest, expires_at)
+            VALUES ($1, $2, now() + make_interval(secs => $3))
+            ON CONFLICT (credential_digest) DO UPDATE SET digest = EXCLUDED.digest, expires_at = EXCLUDED.expires_at
+            """, Digest(secret, 64), credential, AccessSeconds);
+        return new MobileSession(Prefix + secret, subject, AccessSeconds);
+    }
+
+    internal async Task<string?> ReadSubject(HttpContext context, CancellationToken ct)
+    {
+        var header = context.Request.Headers.Authorization.ToString();
+        if (!header.StartsWith("Bearer " + Prefix, StringComparison.OrdinalIgnoreCase)) return null;
+        var access = Digest(header[(7 + Prefix.Length)..], 64);
+        if (access is null) return null;
+        await using var db = await source.OpenConnectionAsync(ct);
+        await using var tx = await db.BeginTransactionAsync(ct);
+        await using var lookup = db.Sql(tx, """
+            SELECT u.subject FROM mobile_access_tokens a
+            JOIN mobile_devices d ON a.credential_digest = d.credential_digest
+            JOIN staff u ON (u.org_id, u.id) = (d.org_id, d.staff_id)
+            WHERE a.digest = $1 AND a.expires_at > now() AND d.expires_at > now()
+              AND d.revoked_at IS NULL AND u.active AND u.subject IS NOT NULL
+            """, access);
+        return (await lookup.ExecuteScalarAsync(ct)) as string;
+    }
+
+    private static byte[]? Digest(string? hex, int length) =>
+        hex is not null && hex.Length == length && hex.All(Uri.IsHexDigit) ? SHA256.HashData(Convert.FromHexString(hex)) : null;
+}
+
+internal sealed class MobileInvitationHandler(IOptionsMonitor<AuthenticationSchemeOptions> options,
+    ILoggerFactory logger, UrlEncoder encoder, MobileInvitationAuth auth)
+    : AuthenticationHandler<AuthenticationSchemeOptions>(options, logger, encoder)
+{
+    protected override async Task<AuthenticateResult> HandleAuthenticateAsync()
+    {
+        var subject = await auth.ReadSubject(Context, Context.RequestAborted);
+        if (subject is null) return AuthenticateResult.Fail("Invalid mobile credential.");
+        var identity = new ClaimsIdentity([new Claim("sub", subject)], Scheme.Name);
+        return AuthenticateResult.Success(new AuthenticationTicket(new ClaimsPrincipal(identity), Scheme.Name));
+    }
+}
