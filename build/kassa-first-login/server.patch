+namespace Kasa.Api;
+
+internal sealed record AssignedMobileRegister(Guid RegisterId, string Name);
+internal sealed record AssignedMobileStore(Guid StoreId, string Name, string TimeZone, int UtcOffsetMinutes,
+    IReadOnlyList<AssignedMobileRegister> Registers);
+internal sealed record AssignedMobileStores(IReadOnlyList<AssignedMobileStore> Items, int? NextOffset);
+
+internal sealed partial class PosService
+{
+    internal async Task<AssignedMobileStores> ListAssignedMobileStores(HttpContext context, int? offset, CancellationToken ct)
+    {
+        var skip = offset ?? 0;
+        if (skip is < 0 or > 1_000_000) throw new PosError(400, "invalid_offset");
+
+        await using var db = await source.OpenConnectionAsync(ct);
+        await using var tx = await db.BeginTransactionAsync(ct);
+        var principal = await Access.ReadPrincipal(db, tx, context, ct);
+        await using var lookup = db.Sql(tx, """
+            WITH assigned_stores AS (
+                SELECT s.id, s.name, s.time_zone
+                FROM staff_stores a JOIN stores s ON (a.org_id, a.store_id) = (s.org_id, s.id)
+                WHERE (a.org_id, a.staff_id) = ($1, $2) AND a.active
+                ORDER BY s.name, s.id OFFSET $3 LIMIT 51
+            )
+            SELECT s.id, s.name, s.time_zone,
+                (extract(epoch FROM (now() AT TIME ZONE s.time_zone) - (now() AT TIME ZONE 'UTC')) / 60)::integer,
+                ARRAY(
+                    SELECT r.id FROM registers r JOIN cashier_registers a
+                    ON (a.org_id, a.store_id, a.register_id) = (r.org_id, r.store_id, r.id)
+                    WHERE (a.org_id, a.staff_id, a.store_id) = ($1, $2, s.id) AND r.active
+                    ORDER BY r.name, r.id),
+                ARRAY(
+                    SELECT r.name FROM registers r JOIN cashier_registers a
+                    ON (a.org_id, a.store_id, a.register_id) = (r.org_id, r.store_id, r.id)
+                    WHERE (a.org_id, a.staff_id, a.store_id) = ($1, $2, s.id) AND r.active
+                    ORDER BY r.name, r.id)
+            FROM assigned_stores s ORDER BY s.name, s.id
+            """, principal.Organization, principal.Id, skip);
+        await using var rows = await lookup.ExecuteReaderAsync(ct);
+        List<AssignedMobileStore> items = [];
+        while (await rows.ReadAsync(ct))
+        {
+            if (items.Count == 50) return new AssignedMobileStores(items, skip + 50);
+            var ids = rows.GetFieldValue<Guid[]>(4);
+            var names = rows.GetFieldValue<string[]>(5);
+            var registers = ids.Zip(names, (id, name) => new AssignedMobileRegister(id, name)).ToArray();
+            items.Add(new AssignedMobileStore(rows.GetGuid(0), rows.GetString(1), rows.GetString(2),
+                rows.GetInt32(3), registers));
+        }
+        return new AssignedMobileStores(items, null);
+    }
+}
