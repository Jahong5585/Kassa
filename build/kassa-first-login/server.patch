+BEGIN;
+
+CREATE TABLE mobile_invitations (
+    digest bytea PRIMARY KEY CHECK (octet_length(digest) = 32),
+    org_id uuid NOT NULL,
+    staff_id uuid NOT NULL,
+    issuer_id uuid NOT NULL REFERENCES platform_staff,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    expires_at timestamptz NOT NULL DEFAULT (now() + interval '15 minutes'),
+    used_at timestamptz,
+    revoked_at timestamptz,
+    FOREIGN KEY (org_id, staff_id) REFERENCES staff
+);
+CREATE INDEX mobile_invitations_staff ON mobile_invitations (org_id, staff_id)
+    WHERE used_at IS NULL AND revoked_at IS NULL;
+
+CREATE TABLE mobile_devices (
+    credential_digest bytea PRIMARY KEY CHECK (octet_length(credential_digest) = 32),
+    invitation_digest bytea NOT NULL UNIQUE REFERENCES mobile_invitations,
+    org_id uuid NOT NULL,
+    staff_id uuid NOT NULL,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    expires_at timestamptz NOT NULL DEFAULT (now() + interval '30 days'),
+    revoked_at timestamptz,
+    FOREIGN KEY (org_id, staff_id) REFERENCES staff
+);
+CREATE INDEX mobile_devices_staff ON mobile_devices (org_id, staff_id) WHERE revoked_at IS NULL;
+
+CREATE TABLE mobile_access_tokens (
+    digest bytea PRIMARY KEY CHECK (octet_length(digest) = 32),
+    credential_digest bytea NOT NULL UNIQUE REFERENCES mobile_devices,
+    expires_at timestamptz NOT NULL
+);
+
+GRANT SELECT, INSERT, UPDATE (used_at, revoked_at) ON mobile_invitations TO kasa_api;
+GRANT SELECT, INSERT, UPDATE (revoked_at) ON mobile_devices TO kasa_api;
+GRANT SELECT, INSERT, UPDATE (digest, expires_at) ON mobile_access_tokens TO kasa_api;
+
+COMMIT;
