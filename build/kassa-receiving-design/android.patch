+
+class _ReceiverLogin extends Login {
+  _ReceiverLogin(super.storage);
+
+  @override
+  String get subject => 'receiver-test';
+
+  @override
+  Future<void> signIn() async {}
+
+  @override
+  Future<String> accessToken({bool force = false}) async => 'test-token';
+}
+
+Future<void> _loadPreviewFont(String family, String variable) async {
+  final path = Platform.environment[variable];
+  if (path == null || path.isEmpty) return;
+  final loader = FontLoader(family)
+    ..addFont(Future.value(ByteData.sublistView(File(path).readAsBytesSync())));
+  await loader.load();
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  final previewDir = Platform.environment['KASSA_RECEIVING_PREVIEW'];
+
+  setUpAll(() async {
+    if (previewDir == null) return;
+    await _loadPreviewFont('Roboto', 'KASSA_PREVIEW_TEXT_FONT');
+    await _loadPreviewFont('MaterialIcons', 'KASSA_PREVIEW_ICONS');
+  });
+
+  testWidgets('compact receiving layout keeps search and submission usable', (tester) async {
+    tester.view.devicePixelRatio = 1;
+    tester.view.physicalSize = const Size(360, 720);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    addTearDown(tester.view.resetPhysicalSize);
+    const storage = FlutterSecureStorage();
+    FlutterSecureStorage.setMockInitialValues({});
+
+    const barcode = '4780012345678';
+    const catalog = '/v1/stores/$testStore/receiving/catalog';
+    Json? submitted;
+    http.Response response(Object data, {int status = 200, String? requestId}) =>
+        http.Response.bytes(
+          utf8.encode(jsonEncode(data)),
+          status,
+          headers: {
+            'content-type': 'application/json; charset=utf-8',
+            if (requestId != null) 'x-request-id': requestId,
+          },
+        );
+
+    final pos = Pos(
+      storage,
+      login: _ReceiverLogin(storage),
+      productionContract: true,
+      client: MockClient((request) async {
+        switch (request.url.path) {
+          case '/v1/me/stores':
+            return response({
+              'items': [
+                {
+                  'storeId': testStore,
+                  'storeName': 'Korzinka',
+                  'timeZone': 'Asia/Tashkent',
+                  'utcOffsetMinutes': 300,
+                  'isOwner': false,
+                  'registers': <Object>[],
+                },
+              ],
+              'nextOffset': null,
+            });
+          case '/v1/me/roles':
+            return response({'storeId': testStore, 'roles': ['receiver']});
+          case '$catalog/barcodes/$barcode':
+            return response({'code': 'product_not_found'}, status: 404);
+          case '$catalog/shared-barcodes/$barcode':
+            return response({
+              'barcode': barcode,
+              'name': 'Чай зелёный',
+              'unit': 'piece',
+              'requiresExpiry': true,
+              'shelfLifeDays': 180,
+              'category': 'Напитки',
+              'brand': 'Демо',
+            });
+          case '$catalog/proposals':
+            expect(request.method, 'POST');
+            submitted = (jsonDecode(request.body) as Json)['product'] as Json;
+            return response({'code': 'invalid_product_card'}, status: 400, requestId: 'receiving-test');
+          default:
+            fail('Unexpected request ${request.url.path}');
+        }
+      }),
+    );
+    addTearDown(pos.api.close);
+
+    final boundaryKey = GlobalKey();
+    Future<void> tap(Finder target) async {
+      await tester.ensureVisible(target);
+      await tester.tap(target);
+      await tester.pumpAndSettle();
+    }
+
+    await tester.pumpWidget(RepaintBoundary(key: boundaryKey, child: KassaApp(pos: pos)));
+    await tester.pumpAndSettle();
+    await tap(find.text('Войти в аккаунт'));
+    await tap(find.text('Korzinka'));
+    await tap(find.text('Войти без кассы'));
+
+    final scan = find.byTooltip('Сканировать штрихкод');
+    final title = find.text('Добавить товар');
