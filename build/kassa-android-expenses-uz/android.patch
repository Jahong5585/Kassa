@@ -0,0 +1,112 @@
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:kassa_mobile/main.dart';
+import 'package:kassa_mobile/pos.dart';
+
+class _AdminLogin extends Login {
+  _AdminLogin(super.storage);
+
+  @override
+  String get subject => 'expense-admin-fixture';
+
+  @override
+  Future<void> signIn() async {}
+
+  @override
+  Future<String> accessToken({bool force = false}) async => 'fixture-token';
+}
+
+void main() {
+  testWidgets('Uzbek expense screen recovers when the route becomes available', (tester) async {
+    tester.view.devicePixelRatio = 1;
+    tester.view.physicalSize = const Size(400, 800);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    addTearDown(tester.view.resetPhysicalSize);
+    FlutterSecureStorage.setMockInitialValues({'kassa.ui.language': 'uz'});
+    const storage = FlutterSecureStorage();
+    const base = '/v1/stores/$testStore';
+    const path = '$base/finance/expenses';
+    var available = false;
+    Json? expense;
+    http.Response response(Object body, {int status = 200}) => http.Response.bytes(
+      utf8.encode(jsonEncode(body)),
+      status,
+      headers: {'content-type': 'application/json; charset=utf-8'},
+    );
+    final pos = Pos(
+      storage,
+      login: _AdminLogin(storage),
+      client: MockClient((request) async {
+        if (request.url.path == '/v1/me/roles') {
+          return response({'storeId': testStore, 'roles': ['admin']});
+        }
+        if (request.url.path == '$base/receiving/catalog/proposals') {
+          return response([]);
+        }
+        expect(request.url.path, path);
+        expect(request.headers['X-Active-Role'], 'admin');
+        if (!available) return response({}, status: 404);
+        if (request.method == 'POST') {
+          expense = {...(jsonDecode(request.body) as Json), 'reversed': false};
+          return response(expense!);
+        }
+        expect(request.method, 'GET');
+        final query = request.url.queryParameters;
+        return response({
+          'storeId': testStore,
+          'from': query['from'],
+          'to': query['to'],
+          'category': query['category'],
+          'includeReversed': query['includeReversed'] == 'true',
+          'items': [if (expense != null) expense],
+          'nextOffset': null,
+        });
+      }),
+    );
+    addTearDown(pos.api.close);
+
+    Future<void> tap(Finder target) async {
+      await tester.ensureVisible(target);
+      await tester.pumpAndSettle();
+      await tester.tap(target);
+      await tester.pumpAndSettle();
+    }
+
+    await tester.pumpWidget(KassaApp(pos: pos, debugPilot: true));
+    await tester.pumpAndSettle();
+    await tap(find.text('Hisobga kirish'));
+    await tap(find.widgetWithText(NavigationDestination, 'Do‘kon'));
+    await tap(find.text('Do‘kon xarajatlari'));
+    expect(find.text('Server do‘kon xarajatlarini hozircha qo‘llamaydi.'), findsOneWidget);
+    expect(find.text('Xarajat qo‘shish'), findsNothing);
+    expect(find.byType(DropdownButtonFormField<String>), findsNothing);
+
+    available = true;
+    await tap(find.text('Qayta tekshirish'));
+    expect(find.text('Toifa'), findsOneWidget);
+    expect(find.text('Barcha toifalar'), findsOneWidget);
+    expect(find.text('Категория'), findsNothing);
+    expect(find.text('Все категории'), findsNothing);
+    await tap(find.text('Xarajat qo‘shish'));
+    expect(find.text('To‘lov usuli'), findsOneWidget);
+    expect(find.text('Naqd pul'), findsOneWidget);
+    await tap(find.text('Boshqa xarajatlar'));
+    await tap(find.text('Yetkazib berish').last);
+    await tester.enterText(find.widgetWithText(TextFormField, 'Summa, so‘m'), '24500');
+    await tester.enterText(find.widgetWithText(TextFormField, 'Tavsif'), 'Sinov yetkazib berish');
+    await tap(find.text('Xarajatni saqlash'));
+
+    expect(expense?['category'], 'delivery');
+    expect(expense?['paymentMethod'], 'cash');
+    expect(expense?['amount'], 24500);
+    expect(find.text('Xarajat saqlandi.'), findsOneWidget);
+    expect(find.textContaining('24500 so‘m'), findsOneWidget);
+    expect(find.textContaining('Yetkazib berish\nNaqd pul'), findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+}
