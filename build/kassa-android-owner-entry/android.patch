+import 'dart:convert';
+import 'package:flutter/material.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:kassa_mobile/main.dart';
+import 'package:kassa_mobile/pos.dart';
+
+const store = '50000000-0000-4000-8000-000000000001';
+const otherStore = '50000000-0000-4000-8000-000000000002';
+const ownerId = '50000000-0000-4000-8000-000000000003';
+const org = '50000000-0000-4000-8000-000000000004';
+const sessionId = '50000000-0000-4000-8000-000000000005';
+
+class OwnerLogin extends Login {
+  OwnerLogin(super.storage);
+  int logins = 0;
+  int confirmations = 0;
+  @override
+  String get subject => 'owner';
+  @override
+  Future<void> signIn() async { logins++; }
+  @override
+  Future<bool> restore() async => false;
+  @override
+  Future<void> reauthenticateOwner() async { confirmations++; }
+  @override
+  Future<String> accessToken({bool force = false}) async => 'owner-bearer';
+}
+
+http.Response reply(Object? data) => http.Response.bytes(utf8.encode(jsonEncode(data)), 200,
+    headers: {'content-type': 'application/json; charset=utf-8'});
+
+void main() {
+  for (final multiple in [false, true]) {
+    testWidgets('fresh owner enters without a second login (multiple=$multiple)', (tester) async {
+      FlutterSecureStorage.setMockInitialValues({});
+      const storage = FlutterSecureStorage();
+      final login = OwnerLogin(storage);
+      final owner = {'operatorId': ownerId, 'displayName': 'Владелец', 'roles': ['admin', 'cashier', 'receiver'],
+        'isOwner': true, 'passwordRequired': false, 'active': true};
+      var sessions = 0;
+      final paths = <String>[];
+      final pos = Pos(storage, login: login, productionContract: true,
+        client: MockClient((request) async {
+          paths.add(request.url.path);
+          if (request.url.path == '/v1/me/stores') return reply({'items': [
+            for (final id in [store, if (multiple) otherStore]) {
+              'organizationId': org, 'storeId': id, 'storeName': id == store ? 'Первый магазин' : 'Второй магазин',
+              'timeZone': 'Asia/Tashkent', 'utcOffsetMinutes': 300, 'isOwner': true, 'active': true,
+            },
+          ], 'nextOffset': null});
+          if (request.url.path == '/v1/stores/$store/operators') return reply({'storeId': store, 'items': [owner]});
+          if (request.url.path == '/v1/stores/$store/operator-sessions') {
+            sessions++;
+            expect((jsonDecode(request.body) as Json)['password'], isNull);
+            return reply({'storeId': store, 'organizationId': org, 'sessionId': sessionId,
+              'registerId': null, 'operatorSessionToken': 'o' * 43, 'operator': owner});
+          }
+          if (request.url.path == '/v1/operator-sessions/current/registers') return reply({'items': []});
+          if (request.url.path == '/v1/stores/$store/receiving/catalog/proposals') return reply([]);
+          if (request.url.path == '/v1/operator-sessions/current') return http.Response('', 204);
+          fail('Unexpected request ${request.url}');
+        }));
+      await storage.write(key: 'kassa.operator.last-store.v1.${pos.api.origin.origin}.owner', value: store);
+      await tester.pumpWidget(KassaApp(pos: pos));
+      await tester.pumpAndSettle();
+      await tester.tap(find.text('Войти в аккаунт'));
+      await tester.pumpAndSettle();
+      if (multiple) {
+        expect(find.text('Первый магазин'), findsOneWidget);
+        expect(find.text('Второй магазин'), findsOneWidget);
+        expect(sessions, 0, reason: 'A remembered store must not hide the other stores');
+        await tester.tap(find.text('Первый магазин'));
+        await tester.pumpAndSettle();
+      }
+      expect(login.logins, 1);
+      expect(login.confirmations, 0);
+      expect(sessions, 1);
+      expect(find.widgetWithText(TextButton, 'Администратор'), findsOneWidget);
+      expect(find.text('Кто работает?'), findsNothing);
+      expect(paths.any((path) => path.contains('test-stores')), false);
+      // Returning from the shared employee chooser requires owner authentication.
+      await tester.tap(find.byTooltip('Сменить сотрудника'));
+      await tester.pumpAndSettle();
+      expect(find.text('Кто работает?'), findsOneWidget);
+      await tester.tap(find.text('Владелец'));
+      await tester.pumpAndSettle();
+      expect(login.confirmations, 1);
+      expect(sessions, 2);
+    });
+  }
+}
