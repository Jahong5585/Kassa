+part of 'main.dart';
+
+const _workplaceSurface = Color(0xfff7f8fa);
+const _workplaceLine = Color(0xffdfe4ec);
+const _workplaceInk = Color(0xff1b2536);
+const _workplaceMeta = Color(0xff536075);
+const _workplaceControlRadius = BorderRadius.all(Radius.circular(10));
+const _kassaFont = 'Roboto';
+
+ThemeData _kassaTheme() {
+  final scheme = ColorScheme.fromSeed(
+    seedColor: _blue,
+    primary: _blue,
+    onPrimary: Colors.white,
+    primaryContainer: const Color(0xffe9eefb),
+    onPrimaryContainer: const Color(0xff20378f),
+    secondaryContainer: const Color(0xffe9eefb),
+    onSecondaryContainer: const Color(0xff20378f),
+    surface: Colors.white,
+    onSurface: _workplaceInk,
+    onSurfaceVariant: _workplaceMeta,
+    outline: const Color(0xff7a879b),
+    outlineVariant: _workplaceLine,
+  );
+  const button = RoundedRectangleBorder(borderRadius: _workplaceControlRadius);
+  const field = OutlineInputBorder(borderRadius: _workplaceControlRadius);
+  const panel = RoundedRectangleBorder(
+    borderRadius: BorderRadius.all(Radius.circular(16)),
+    side: BorderSide(color: _workplaceLine),
+  );
+  return ThemeData(
+    colorScheme: scheme,
+    scaffoldBackgroundColor: _workplaceSurface,
+    fontFamily: _kassaFont,
+    appBarTheme: const AppBarTheme(
+      backgroundColor: _navy,
+      foregroundColor: Colors.white,
+      surfaceTintColor: Colors.transparent,
+      titleTextStyle: TextStyle(
+        color: Colors.white,
+        fontFamily: _kassaFont,
+        fontSize: 20,
+        fontWeight: FontWeight.w500,
+      ),
+    ),
+    filledButtonTheme: FilledButtonThemeData(
+      style: FilledButton.styleFrom(minimumSize: const Size(0, 48), shape: button),
+    ),
+    outlinedButtonTheme: OutlinedButtonThemeData(
+      style: OutlinedButton.styleFrom(
+        minimumSize: const Size(0, 48),
+        foregroundColor: _workplaceInk,
+        side: const BorderSide(color: _workplaceLine),
+        shape: button,
+      ),
+    ),
+    textButtonTheme: TextButtonThemeData(
+      style: TextButton.styleFrom(shape: button),
+    ),
+    inputDecorationTheme: const InputDecorationTheme(
+      filled: true,
+      fillColor: Colors.white,
+      border: field,
+      enabledBorder: OutlineInputBorder(
+        borderRadius: _workplaceControlRadius,
+        borderSide: BorderSide(color: Color(0xffaeb9c9)),
+      ),
+      focusedBorder: OutlineInputBorder(
+        borderRadius: _workplaceControlRadius,
+        borderSide: BorderSide(color: _blue, width: 2),
+      ),
+    ),
+    cardTheme: const CardThemeData(
+      color: Colors.white,
+      surfaceTintColor: Colors.transparent,
+      elevation: 0,
+      margin: EdgeInsets.only(bottom: 12),
+      shape: panel,
+    ),
+    dialogTheme: const DialogThemeData(
+      backgroundColor: Colors.white,
+      surfaceTintColor: Colors.transparent,
+      shape: panel,
+    ),
+    dividerTheme: const DividerThemeData(color: _workplaceLine, thickness: 1),
+    useMaterial3: true,
+  );
+}
+
+class _WorkplacePage extends StatelessWidget {
+  const _WorkplacePage({
+    required this.title,
+    required this.children,
+    this.actions = const [],
+  });
+
+  final Widget title;
+  final List<Widget> children;
+  final List<Widget> actions;
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+    appBar: AppBar(title: title, actions: actions),
+    body: SafeArea(
+      top: false,
+      child: ListView(
+        padding: const EdgeInsets.fromLTRB(20, 16, 20, 24),
+        children: children,
+      ),
+    ),
+  );
+}
+
+class _WorkplaceRow extends StatelessWidget {
+  const _WorkplaceRow({required this.child});
+
+  final ListTile child;
+
+  @override
+  Widget build(BuildContext context) => Padding(
+    padding: const EdgeInsets.only(bottom: 4),
+    child: Material(
+      color: Colors.white,
+      clipBehavior: Clip.antiAlias,
+      shape: const RoundedRectangleBorder(
+        borderRadius: _workplaceControlRadius,
+        side: BorderSide(color: _workplaceLine),
+      ),
+      child: ListTileTheme(
+        data: const ListTileThemeData(
+          contentPadding: EdgeInsets.symmetric(horizontal: 12),
+          minVerticalPadding: 12,
+          horizontalTitleGap: 12,
+          iconColor: _workplaceMeta,
+          titleTextStyle: TextStyle(
+            color: _workplaceInk,
+            fontFamily: _kassaFont,
+            fontSize: 16,
+            fontWeight: FontWeight.w500,
+          ),
+          subtitleTextStyle: TextStyle(
+            color: _workplaceMeta,
+            fontFamily: _kassaFont,
+            fontSize: 13,
+            height: 1.4,
+          ),
+        ),
+        child: child,
+      ),
+    ),
+  );
+}
+
+class _RegisterStatusDot extends StatelessWidget {
+  const _RegisterStatusDot({required this.active});
+
+  final bool active;
+
+  @override
+  Widget build(BuildContext context) => DecoratedBox(
+    decoration: BoxDecoration(
+      color: active ? const Color(0xff26734e) : _workplaceMeta,
+      shape: BoxShape.circle,
+    ),
+    child: const SizedBox.square(dimension: 8),
+  );
+}
