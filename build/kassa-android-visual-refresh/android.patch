+
+const _store = '30000000-0000-4000-8000-000000000031';
+const _ownerId = '30000000-0000-4000-8000-000000000033';
+const _register = '30000000-0000-4000-8000-000000000032';
+const _base = '/v1/stores/$_store';
+const _uuidName = '03f38b39-cb90-4f8d-8fd3-578078008aae';
+class _Host extends Login {
+  _Host(super.storage);
+  @override
+  String get subject => 'visual-owner';
+  @override
+  Future<bool> restore() async => true;
+  @override
+  Future<void> reauthenticateOwner() async {}
+  @override
+  Future<String> accessToken({bool force = false}) async => 'visual-token';
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  final preview = Platform.environment['KASSA_WORKSPACE_PREVIEW'];
+  setUpAll(() async {
+    for (final entry in {'Roboto':'KASSA_PREVIEW_TEXT_FONT', 'MaterialIcons':'KASSA_PREVIEW_ICONS'}.entries) {
+      final path = Platform.environment[entry.value];
+      if (preview == null || path == null || path.isEmpty) continue;
+      await (FontLoader(entry.key)..addFont(Future.value(ByteData.sublistView(File(path).readAsBytesSync())))).load();
+    }
+  });
+
+  testWidgets('workspace tour checks titles, controls, lists and forms at phone sizes', (tester) async {
+    tester.view.devicePixelRatio = 1;
+    tester.view.physicalSize = const Size(390, 844);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    addTearDown(tester.view.resetPhysicalSize);
+    FlutterSecureStorage.setMockInitialValues({});
+    var emptyStaff = false;
+    const owner = {'operatorId':_ownerId, 'displayName':_uuidName, 'roles':['admin','cashier','receiver'],
+      'isOwner':true, 'passwordRequired':false, 'active':true};
+    const employee = {'employeeId':'30000000-0000-4000-8000-000000000039',
+      'displayName':'Abdulaziz Jamolov', 'roles':['cashier','receiver'], 'active':true,'version':1};
+    http.Response reply(Object data) => http.Response.bytes(utf8.encode(jsonEncode(data)), 200,
+      headers:{'content-type':'application/json; charset=utf-8'});
+    final pos = Pos(const FlutterSecureStorage(), login:_Host(const FlutterSecureStorage()),
+      productionContract:true, client:MockClient((request) async {
+        final q=request.url.queryParameters;
+        switch(request.url.path) {
+          case '/v1/me/stores':
+            return reply({'items':[{'storeId':_store,'storeName':'Korzinka','organizationId':_ownerId,
+              'timeZone':'Asia/Tashkent','utcOffsetMinutes':300,'isOwner':true,'active':true}], 'nextOffset':null});
+          case '$_base/operators':
+            return reply({'storeId':_store,'items':[owner]});
+          case '$_base/operator-sessions':
+            return reply({'storeId':_store,'organizationId':_ownerId,'sessionId':_register,
+              'operatorSessionToken':'v'*43,'operator':owner});
+          case '/v1/me/roles':
+            return reply({'storeId':_store,'staffId':_ownerId,'owner':true,'roles':owner['roles']});
+          case '$_base/receiving/catalog/proposals':
+          case '$_base/receipts':
+          case '$_base/suppliers':
+          case '$_base/stock/lots':
+          case '$_base/stock/inventories':
+          case '$_base/procurement/orders':
+            return reply([]);
+          case '$_base/employees':
+            return reply({'items':emptyStaff ? [] : [employee], 'nextOffset':null});
+          case '$_base/registers':
+            return reply([
+              {'registerId':_register,'name':'Касса3','active':true,'version':1,'cashierIds':[_ownerId]},
+              {'registerId':_store,'name':'Основная касса у входа в магазин','active':true,'version':1,'cashierIds':[_ownerId,employee['employeeId']]},
+              {'registerId':_ownerId,'name':'kassa2','active':true,'version':1,'cashierIds':[employee['employeeId']]},
+            ]);
+          case '$_base/catalog/products':
+            return reply([{'productId':_register,'name':'Капучино UNO Momento с шоколадной крошкой, 25 г',
+              'barcode':'9556771003938','unitPrice':5000,'unit':'piece','active':true}]);
+          case '$_base/finance/expenses':
+            return reply({'storeId':_store,'from':q['from'],'to':q['to'],'category':q['category'],
+              'includeReversed':q['includeReversed']=='true','items':[]});
+          default: fail('Unexpected visual tour request ${request.url.path}');
+        }
+      }));
+    final boundary=GlobalKey();
+    Future<void> shot(String name) async {
+      expect(tester.takeException(), isNull, reason:name);
+      if(preview==null) return;
+      await tester.runAsync(() async {
+        final object=boundary.currentContext!.findRenderObject() as RenderRepaintBoundary;
+        final img=await object.toImage(pixelRatio:2);
+        try {
+          final bytes=await img.toByteData(format:ui.ImageByteFormat.png);
+          File('$preview/$name.png')..parent.createSync(recursive:true)
+            ..writeAsBytesSync(bytes!.buffer.asUint8List());
+        } finally {img.dispose();}
+      });
+    }
+    Future<void> tap(Finder f) async {
+      await tester.ensureVisible(f);
+      await tester.pumpAndSettle();
+      await tester.tap(f);
+      await tester.pumpAndSettle();
+    }
+    Future<void> back() async {await tester.pageBack(); await tester.pumpAndSettle();}
+    Future<void> tab(String text) => tap(find.widgetWithText(NavigationDestination,text));
+
+    await tester.pumpWidget(RepaintBoundary(key:boundary,child:KassaApp(pos:pos)));
+    await tester.pumpAndSettle();
+    expect(find.text(_uuidName),findsNothing);
+    await shot('01-employee-login');
+    await tap(find.text('Владелец магазина'));
+    expect(find.text('Korzinka'),findsOneWidget);
+    expect(find.text(_uuidName),findsNothing);
+    await shot('02-overview');
+    await tap(find.text('Карточки товаров'));
+    await shot('03-proposals-empty');
+    await back();
+    await tap(find.text('Сотрудники').hitTestable());
+    expect(find.text('Abdulaziz Jamolov').hitTestable(),findsOneWidget);
+    await shot('04-employees');
+    await tap(find.text('Добавить'));
+    await shot('05-new-employee');
+    await tap(find.text('Отмена'));
+    await tap(find.text('Кассы'));
+    await shot('06-registers');
+    await tap(find.byTooltip('Действия кассы').first);
+    await shot('07-register-actions');
+    await back();
+    await tap(find.text('Сотрудники'));
+    emptyStaff=true;
+    await tap(find.byTooltip('Обновить'));
+    await shot('08-employees-empty');
+    await back();
+    await tap(find.text('Каталог'));
+    await shot('09-catalog');
+    await tap(find.byTooltip('Добавить товар'));
+    await shot('10-new-product');
+    await tap(find.text('Дополнительно'));
+    await shot('11-product-details');
+    await back();
+    await back();
+    await tab('Товары');
+    await shot('12-stock-menu');
+    await tap(find.text('Поставщики'));
+    await shot('13-suppliers');
+    await tap(find.text('Добавить поставщика'));
+    await shot('14-new-supplier');
+    await back(); await back();
+    await tab('Магазин');
+    await shot('15-store-menu');
+    await tap(find.text('Расходы магазина'));
+    await shot('16-expenses');
+    await tap(find.text('Добавить расход'));
+    await shot('17-new-expense');
+    await back(); await back();
+    await tap(find.text('Покупатели'));
+    await shot('18-customers');
+    await back();
+    await tap(find.text('Отчёты магазина'));
+    await shot('19-report-menu');
+    await back();
+    await tab('Ещё');
+    await shot('20-settings');
+    await tap(find.widgetWithText(TextButton,'Администратор'));
+    await tap(find.widgetWithText(CheckedPopupMenuItem<Object>,'Приёмщик'));
+    expect(find.text(_uuidName),findsNothing);
+    await shot('21-receiving');
+    await tab('Накладные');
+    await shot('22-receiving-documents');
+
+    tester.view.physicalSize=const Size(320,740);
+    await tester.pumpAndSettle();
+    await tab('Товар');
+    await shot('23-narrow-receiving');
+    await tap(find.widgetWithText(TextButton,'Приёмщик'));
+    await tap(find.widgetWithText(CheckedPopupMenuItem<Object>,'Администратор'));
+    await shot('24-narrow-overview');
+  });
+}
